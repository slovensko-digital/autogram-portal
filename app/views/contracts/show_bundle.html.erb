<%= turbo_frame_tag @contract do %>
  <% manageable = policy(@contract.bundle).manage? %>
  <% actions_menu = render("contracts/document_actions_menu", contract: @contract) if manageable %>
  <% signature_fields_badge = if manageable && @contract.signature_field_preparations.any?
       if @contract.prepared_signature_fields_source_attached?
         render "shared/badge", color: "blue", label: t('.signature_fields_badge', count: @contract.signature_field_preparations.size)
       elsif @contract.pades_field_preparation_allowed?
         render "shared/badge", color: "yellow", label: t('.signature_fields_unfinished_badge')
       end
     end %>
  <%= render 'contracts/visualization_with_toggle', contract: @contract, actions: actions_menu.presence, badge: signature_fields_badge %>

  <%= turbo_frame_tag "signature_validation_#{@contract.uuid}",
            src: validate_contract_path(@contract),
            loading: "lazy",
            class: "w-full" do %>
    <%= render "bundles/loading", message: t('contracts.signature_validation.validating') %>
  <% end %>

  <%= render("layouts/flash", flash: flash) %>

  <% if manageable && @contract.signed_document.attached? %>
    <div class="mt-4 flex justify-end">
      <%= link_to signed_document_contract_path(@contract), data: { turbo: false },
            class: "btn btn-primary w-full sm:w-auto" do %>
        <%= t('contracts.download_actions.download_button') %>
      <% end %>
    </div>
  <% end %>
<% end %>
