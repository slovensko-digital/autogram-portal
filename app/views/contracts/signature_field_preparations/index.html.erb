<% content_for :title, t('.title') %>

<% editing = @signature_field_preparation.persisted? %>
<% placing = @recipients.present? || editing %>
<% document = @signature_field_preparation.document || @documents.first %>
<% preview_document = @preview_document || document %>
<% preview_path = preview_document&.blob&.attached? ? rails_blob_path(preview_document.blob, disposition: "inline") : nil %>
<% existing_signature_field_previews = @signature_field_preparations.filter_map do |preparation| %>
  <% next unless document.present? && preparation.document_id == document.id %>
  <% next if editing && preparation.id == @signature_field_preparation.id %>
  <% {
    page: preparation.page,
    x: preparation.x.to_f,
    y: preparation.y.to_f,
    width: preparation.width.to_f,
    height: preparation.height.to_f,
    recipientName: preparation.recipient.display_name,
    editUrl: edit_contract_signature_field_preparation_path(@contract, preparation),
    editLabel: t('.preview.edit_field', recipient: preparation.recipient.display_name)
  } %>
<% end %>
<% placed_count = @awaiting_recipients.count { |recipient| @preparations_by_recipient_id.key?(recipient.id) } %>

<div>
  <div class="mx-auto max-w-6xl space-y-6 px-6 pb-24 pt-10 lg:px-8" data-signature-field-preparations-layout="page">
    <div>
      <%= link_to bundle_path(@contract.bundle), class: "inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800 hover:underline" do %>
        <svg aria-hidden="true" class="mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        <%= t('.back') %>
      <% end %>

      <h1 class="mt-4 text-3xl font-bold text-gray-900"><%= t('.title') %></h1>
      <p class="mt-1 text-gray-600"><%= t('.subtitle') %></p>
      <% if document %>
        <p class="mt-1 text-sm text-gray-600"><%= document.filename %></p>
      <% end %>
    </div>

    <% case prepared_pdf_state %>
    <% when :none %>
      <div class="rounded-lg border border-gray-200 bg-gray-50 p-4 text-sm text-gray-700">
        <%= t('.status.none') %>
      </div>
    <% when :stale %>
      <div class="rounded-lg border border-amber-200 bg-amber-50 p-4">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="text-sm text-amber-900">
            <p class="font-semibold"><%= t('.status.stale_title') %></p>
            <p class="mt-1"><%= t('.status.stale_body') %></p>
          </div>
          <%= button_to t('.finalize.submit'),
                        finalize_contract_signature_field_preparations_path(@contract),
                        method: :post,
                        class: "btn btn-primary shrink-0" %>
        </div>
      </div>
    <% when :ready %>
      <div class="rounded-lg border border-green-200 bg-green-50 p-4">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="text-sm text-green-900">
            <p class="font-semibold"><%= t('.status.ready_title') %></p>
            <p class="mt-1"><%= t('.status.ready_body') %></p>
          </div>
          <%= link_to t('.status.back_to_bundle'), bundle_path(@contract.bundle),
                class: "inline-flex shrink-0 justify-center items-center px-4 py-2 border border-green-300 text-sm font-medium rounded-md text-green-800 bg-white hover:bg-green-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-600" %>
        </div>
      </div>
    <% end %>

    <%= form_with scope: :signature_field_preparation,
                  url: editing ? contract_signature_field_preparation_path(@contract, @signature_field_preparation) : contract_signature_field_preparations_path(@contract),
                  method: editing ? :patch : :post,
                  local: true,
                  data: {
                    controller: "visual-stamp",
                    visual_stamp_preview_url_value: preview_path,
                    visual_stamp_existing_fields_value: existing_signature_field_previews.to_json,
                    visual_stamp_page_width_value: 595,
                    visual_stamp_page_height_value: 842,
                    visual_stamp_x_value: @signature_field_preparation.x,
                    visual_stamp_y_value: @signature_field_preparation.y,
                    visual_stamp_width_value: @signature_field_preparation.width,
                    visual_stamp_height_value: @signature_field_preparation.height,
                    visual_stamp_max_width_value: VisualStamp::MAX_WIDTH,
                    visual_stamp_max_height_value: VisualStamp::MAX_HEIGHT
                  } do |form| %>
      <%= form.hidden_field :document_uuid, value: document&.uuid unless editing %>
      <%= form.hidden_field :page, value: @signature_field_preparation.page, data: { visual_stamp_target: "pageField" } %>

      <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <div class="min-w-0 rounded-lg border border-gray-200 bg-gray-100 p-4">
          <div class="mb-3 flex items-center justify-center gap-2">
            <%= button_tag type: "button",
                  aria: { label: t('.preview.previous_page') },
                  data: { visual_stamp_target: "previousPageButton", action: "visual-stamp#previousPage" },
                  class: "inline-flex h-8 w-8 items-center justify-center rounded-md border border-gray-300 bg-white text-gray-700 cursor-pointer hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-40" do %>
              <svg aria-hidden="true" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
            <% end %>
            <label class="flex items-center gap-2 text-sm text-gray-700">
              <span><%= t('.preview.page') %></span>
              <%= number_field_tag :signature_field_preparation_page_preview,
                                   @signature_field_preparation.page,
                                   min: 1,
                                   step: 1,
                                   class: "w-16 rounded-md border border-gray-500 px-2 py-1 text-sm text-center focus:outline-none focus:border-blue-500 focus:ring-blue-500",
                                   data: { visual_stamp_target: "pageNumber", action: "input->visual-stamp#pageChanged" } %>
              <span><%= t('.preview.page_of') %> <span data-visual-stamp-target="pageCount">–</span></span>
            </label>
            <%= button_tag type: "button",
                  aria: { label: t('.preview.next_page') },
                  data: { visual_stamp_target: "nextPageButton", action: "visual-stamp#nextPage" },
                  class: "inline-flex h-8 w-8 items-center justify-center rounded-md border border-gray-300 bg-white text-gray-700 cursor-pointer hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-40" do %>
              <svg aria-hidden="true" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            <% end %>
          </div>

          <div class="w-full max-w-full overflow-hidden pb-2">
            <div class="mx-auto w-full max-w-[680px]">
              <div class="relative mx-auto aspect-[595/842] w-full overflow-hidden rounded-sm bg-white" data-visual-stamp-target="page">
                <% if preview_path %>
                  <canvas data-visual-stamp-target="pdfCanvas" class="block h-full w-full bg-white"></canvas>
                  <div data-visual-stamp-target="previewFallback" class="absolute inset-0 hidden flex items-center justify-center bg-white/90 p-6 text-center text-sm text-gray-600">
                    <div class="space-y-3">
                      <p><%= t('.preview.render_error') %></p>
                      <a data-visual-stamp-target="previewLink" href="<%= preview_path %>" target="_blank" rel="noopener" class="btn btn-primary"><%= t('.preview.open_pdf') %></a>
                    </div>
                  </div>
                <% else %>
                  <div class="absolute inset-0 flex items-center justify-center p-6 text-center text-sm text-gray-500">
                    <%= t('.preview.unavailable') %>
                  </div>
                <% end %>

                <div class="absolute inset-0 pointer-events-none" data-visual-stamp-target="existingFieldsLayer"></div>

                <div data-visual-stamp-target="stamp"
                     data-action="pointerdown->visual-stamp#startDrag keydown->visual-stamp#moveWithKeyboard"
                     role="group"
                     tabindex="0"
                     aria-label="<%= t('shared.stamp_geometry.box_label') %>"
                     aria-describedby="signature_field_preparation_geometry_hint"
                     class="absolute z-10 cursor-move select-none rounded border-2 border-blue-600 bg-white/90 p-2 ring-2 ring-white/70 touch-none focus:outline-none focus-visible:ring-blue-600 <%= 'hidden' unless placing %>">
                  <div class="text-xs font-medium text-gray-800" data-visual-stamp-target="boxLabel"><%= editing ? @signature_field_preparation.recipient.display_name : t('.preview.box_label') %></div>
                  <button type="button"
                          aria-label="<%= t('.preview.resize_handle') %>"
                          data-visual-stamp-handle="resize"
                          aria-describedby="signature_field_preparation_geometry_hint"
                          data-action="pointerdown->visual-stamp#startResize keydown->visual-stamp#resizeWithKeyboard"
                          class="absolute -bottom-2 -right-2 h-5 w-5 cursor-se-resize rounded-full border border-blue-700 bg-blue-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2"></button>
                </div>
              </div>
            </div>
          </div>
          <% if placing %>
            <%= render "shared/stamp_geometry_fields",
                  name_prefix: "signature_field_preparation",
                  x: @signature_field_preparation.x, y: @signature_field_preparation.y,
                  width: @signature_field_preparation.width, height: @signature_field_preparation.height,
                  invalid: @signature_field_preparation.errors.attribute_names & %i[x y width height] %>
          <% end %>
        </div>

        <aside class="min-w-0 space-y-4 self-start rounded-lg border border-gray-200 bg-white p-4">
          <% if editing %>
            <div>
              <h2 class="text-base font-semibold text-gray-900"><%= t('.form.editing_title') %></h2>
              <p class="mt-1 text-sm text-gray-600">
                <span class="font-medium text-gray-900"><%= t('.form.recipient') %>:</span>
                <%= @signature_field_preparation.recipient.display_name %>
              </p>
            </div>

            <p class="text-sm text-gray-600"><%= t('.form.hint') %></p>

            <%= form.submit t('.form.update_submit'),
                  class: "btn btn-primary w-full" %>
            <%= link_to t('.form.cancel'), contract_signature_field_preparations_path(@contract),
                  class: "btn btn-secondary w-full" %>
          <% elsif @recipients.present? && document.present? %>
            <div>
              <%= form.label :recipient_uuid, t('.form.recipient'), class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= form.select :recipient_uuid,
                              options_from_collection_for_select(@recipients, :uuid, :display_name, @signature_field_preparation.recipient&.uuid),
                              {},
                              class: "block w-full rounded-md border border-gray-500 px-3 py-2 text-sm focus:outline-none focus:border-blue-500 focus:ring-blue-500",
                              data: { visual_stamp_target: "recipientSelect", action: "change->visual-stamp#recipientChanged" } %>
            </div>

            <p class="text-sm text-gray-600"><%= t('.form.hint') %></p>

            <%= form.submit t('.form.submit'),
                  class: "btn btn-primary w-full" %>
          <% elsif @awaiting_recipients.present? && document.present? %>
            <div class="rounded-lg border border-green-200 bg-green-50 p-4 text-sm text-green-900">
              <p class="font-semibold"><%= t('.form.all_assigned_title') %></p>
              <% if prepared_pdf_state == :stale %>
                <p class="mt-1"><%= t('.form.all_assigned_body') %></p>
              <% end %>
            </div>
          <% else %>
            <div class="rounded-lg border border-gray-200 bg-gray-50 p-4 text-sm text-gray-700">
              <p class="font-semibold"><%= t('.empty_state_title') %></p>
              <p class="mt-1"><%= t('.empty_state_body') %></p>
              <%= link_to t('.empty_state_link'), bundle_path(@contract.bundle),
                    class: "mt-2 inline-block font-medium text-blue-600 underline hover:text-blue-800" %>
            </div>
          <% end %>
        </aside>
      </div>
    <% end %>

    <section class="rounded-lg border border-gray-200 bg-white p-6">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-xl font-semibold text-gray-900"><%= t('.recipients.title') %></h2>
        <span class="text-sm text-gray-600"><%= t('.recipients.progress', placed: placed_count, total: @awaiting_recipients.size) %></span>
      </div>

      <% if @awaiting_recipients.blank? %>
        <p class="mt-4 text-sm text-gray-600"><%= t('.recipients.empty') %></p>
      <% else %>
        <div class="mt-4 space-y-3">
          <% @awaiting_recipients.each do |recipient| %>
            <% preparation = @preparations_by_recipient_id[recipient.id] %>
            <% row_editing = editing && preparation&.id == @signature_field_preparation.id %>
            <div class="flex flex-wrap items-center gap-3 rounded-lg border px-4 py-3 <%= row_editing ? 'border-blue-400 bg-blue-50' : 'border-gray-200' %>">
              <div class="h-9 w-9 shrink-0 rounded-lg bg-blue-50 flex items-center justify-center">
                <svg aria-hidden="true" class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 8.25v7.5a2.25 2.25 0 01-2.25 2.25H4.5a2.25 2.25 0 01-2.25-2.25v-7.5m19.5 0-8.69 5.216a2.25 2.25 0 01-2.122 0L2.25 8.25m19.5 0A2.25 2.25 0 0019.5 6H4.5a2.25 2.25 0 00-2.25 2.25" />
                </svg>
              </div>
              <div class="min-w-0 flex-1 break-words text-base font-semibold text-gray-900"><%= recipient.display_name %></div>
              <% if preparation %>
                <%= render 'shared/badge', color: 'green', label: t('.recipients.placed', page: preparation.page) %>
                <%= link_to edit_contract_signature_field_preparation_path(@contract, preparation),
                            class: "text-sm font-medium text-blue-600 underline hover:text-blue-800" do %>
                  <%= t('.recipients.edit') %><span class="sr-only">: <%= recipient.display_name %></span>
                <% end %>
                <%= button_to contract_signature_field_preparation_path(@contract, preparation),
                              method: :delete,
                              class: "text-sm font-medium text-red-600 underline cursor-pointer hover:text-red-800",
                              form: { data: { turbo_confirm: t('.recipients.remove_confirm', recipient: recipient.display_name) } } do %>
                  <%= t('actions.remove') %><span class="sr-only">: <%= recipient.display_name %></span>
                <% end %>
              <% else %>
                <%= render 'shared/badge', color: 'gray', label: t('.recipients.not_placed') %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </section>
  </div>
</div>
