<%# locals: () %>
<% point_icon_class = "flex h-9 w-9 shrink-0 items-center justify-center rounded-lg" %>

<section class="max-w-3xl rounded-lg border border-gray-200 bg-white p-6" aria-labelledby="signature_fields_introduction_title" data-signature-field-preparations-introduction>
  <h2 id="signature_fields_introduction_title" class="text-lg font-semibold text-gray-900"><%= t('.title') %></h2>
  <p class="mt-2 text-gray-600"><%= t('.description') %></p>

  <ul role="list" class="mt-6 space-y-5">
    <li class="flex gap-4">
      <span aria-hidden="true" class="<%= point_icon_class %> bg-yellow-50 text-yellow-700">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
        </svg>
      </span>
      <div>
        <h3 class="font-semibold text-gray-900"><%= t('.before_first_signature.title') %></h3>
        <p class="mt-1 text-sm leading-6 text-gray-600"><%= t('.before_first_signature.description') %></p>
      </div>
    </li>
    <li class="flex gap-4">
      <span aria-hidden="true" class="<%= point_icon_class %> bg-yellow-50 text-yellow-700">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
        </svg>
      </span>
      <div>
        <h3 class="font-semibold text-gray-900"><%= t('.mobile_only.title') %></h3>
        <p class="mt-1 text-sm leading-6 text-gray-600"><%= t('.mobile_only.description') %></p>
      </div>
    </li>
    <li class="flex gap-4">
      <span aria-hidden="true" class="<%= point_icon_class %> bg-gray-100 text-gray-600">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
        </svg>
      </span>
      <div>
        <h3 class="font-semibold text-gray-900"><%= t('.pades_only.title') %></h3>
        <p class="mt-1 text-sm leading-6 text-gray-600"><%= t('.pades_only.description') %></p>
      </div>
    </li>
  </ul>

  <div class="mt-6 border-t border-gray-200 pt-5">
    <h3 class="text-sm font-medium text-gray-700"><%= t('.recipients_title') %></h3>
    <ul role="list" class="mt-2 flex flex-wrap gap-2">
      <% @awaiting_recipients.each do |recipient| %>
        <li class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 px-3 py-1 text-sm text-gray-700">
          <svg aria-hidden="true" class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
          </svg>
          <%= recipient.display_name %>
        </li>
      <% end %>
    </ul>
    <%= link_to t('.missing_recipient'), bundle_path(@contract.bundle),
          class: "mt-3 inline-flex min-h-6 items-center text-sm font-medium text-blue-700 underline underline-offset-2 hover:text-blue-900" %>
  </div>

  <%= form_with url: contract_signature_field_preparations_path(@contract), method: :get, local: true, class: "mt-6 space-y-5" do |form| %>
    <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-yellow-300 bg-yellow-50 p-4 text-sm text-yellow-900">
      <%= form.check_box :acknowledged, { required: true, class: "mt-0.5 h-4 w-4 shrink-0 rounded border-gray-400 text-blue-600 focus:ring-blue-500" }, "1", nil %>
      <span><%= t('.acknowledgement') %></span>
    </label>

    <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
      <%= link_to t('.cancel'), bundle_path(@contract.bundle), class: "btn btn-secondary" %>
      <%= form.submit t('.continue'), name: nil, class: "btn btn-primary" %>
    </div>
  <% end %>
</section>
