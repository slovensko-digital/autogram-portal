<% content_for :title, t('.title') %>

<div class="mx-auto max-w-3xl">
  <div class="relative isolate overflow-hidden">
    <div class="mx-auto flex flex-col max-w-4xl space-y-6 px-6 pb-8 pt-10 lg:flex lg:px-8">
      <div class="space-y-8">
        <h1 class="text-4xl font-semibold text-gray-900"><%= t('.title') %></h1>
        <% scope = qscd_onboarding_variant(@selected_qscd) == "cz" ? "contracts.onboarding.legacy_eid_card.cz" : "contracts.onboarding.legacy_eid_card" %>
        <p class="text-md text-gray-600"><%= t("#{scope}.description") %></p>

        <%= render 'shared/warning',
          title: t("#{scope}.warning_title"),
          content: t("#{scope}.warning_description")
        %>

      </div>

      <div class="mb-8 border-t border-gray-200"></div>

      <%= link_to contract_onboarding_path(@contract, 'qscd_check', method: params[:method], recipient: params[:recipient], bundle_id: params[:bundle_id], iframe: params[:iframe], review: params[:review]),
          class: "btn btn-secondary flex-1" do %>
        <%= t('actions.back') %>
      <% end %>
    </div>
  </div>
</div>
