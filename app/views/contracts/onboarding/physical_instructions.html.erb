<% content_for :title, t('.title') %>

<div class="mx-auto max-w-3xl">
  <div class="relative isolate overflow-hidden">
    <div class="mx-auto flex flex-col max-w-4xl space-y-6 px-6 pb-8 pt-10 lg:flex lg:px-8">
      <div>
        <h1 class="text-4xl font-semibold text-gray-900 mb-2"><%= t('.title') %></h1>
        <p class="text-md text-gray-600 mb-4">
          <%= t('.description') %>
        </p>

        <ol class="list-decimal list-inside space-y-2 text-md text-gray-700 mb-6">
          <li><%= t('.step1') %></li>
          <li><%= t('.step2') %></li>
          <li><%= t('.step3') %></li>
          <li><%= t('.step4') %></li>
        </ol>

        <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
          <p class="text-base text-gray-700">
            <%= t('.note') %>
          </p>
        </div>
      </div>

      <div class="my-8 border-t border-gray-200"></div>

      <%= form_with url: contract_onboarding_path(@contract, @step), method: :patch do |f| %>
        <%= hidden_field_tag :recipient, @recipient&.uuid if @recipient %>
        <%= hidden_field_tag :method, @method %>
        <%= hidden_field_tag :review, params[:review] if params[:review] %>
        <%= hidden_field_tag :iframe, params[:iframe] %>

        <div class="flex gap-8">
          <%= link_to signing_page_path(@contract, recipient: @recipient, iframe: params[:iframe]),
              class: "btn btn-secondary flex-1" do %>
            <%= t('actions.back') %>
          <% end %>
          <%= f.submit t('.continue'), class: "btn btn-primary flex-1" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
