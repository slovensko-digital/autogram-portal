<% variant = qscd_onboarding_variant(@selected_qscd) %>
<% scope = variant == "sk" ? "contracts.onboarding.pin_check" : "contracts.onboarding.pin_check.#{variant}" %>
<% content_for :title, t("#{scope}.title") %>

<%# Onboarding is a page of its own, also when a signing apps frame was redirected here. %>
<%= turbo_frame_tag "signature_apps_#{@contract.uuid}", target: "_top" do %>
<div class="mx-auto max-w-3xl sm:mb-20">
  <div class="relative isolate overflow-hidden">
    <div class="mx-auto flex flex-col max-w-4xl space-y-6 px-6 pb-8 pt-10 lg:flex lg:px-8">
      <div class="space-y-8">
        <h1 class="text-4xl font-semibold text-gray-900"><%= t("#{scope}.title") %></h1>
        <p class="text-md text-gray-600"><%= t("#{scope}.description_a") %></p>
        <p class="text-md text-gray-600"><%= t("#{scope}.description_b") %></p>

        <%= render 'shared/info',
          title: t("#{scope}.no_pin_title"),
          content: t("#{scope}.no_pin_description"),
          button: t("#{scope}.no_pin_learn_more", default: nil),
          target: t("#{scope}.no_pin_learn_more_url", default: nil)
        %>

      </div>

      <div class="mb-8 border-t border-gray-200"></div>

      <%= form_with url: contract_onboarding_path(@contract, @step), method: :patch do |f| %>
        <%= hidden_field_tag :recipient, @recipient&.uuid if @recipient %>
        <%= hidden_field_tag :method, @method %>
        <%= hidden_field_tag :review, params[:review] if params[:review] %>
        <%= hidden_field_tag :iframe, params[:iframe] %>
        <%= hidden_field_tag :qscd, params[:qscd] if params[:qscd].present? %>

        <div class="flex gap-8">
          <%= link_to contract_onboarding_path(@contract, 'qscd_check', method: params[:method], recipient: params[:recipient], bundle_id: params[:bundle_id], iframe: params[:iframe], review: params[:review], qscd: params[:qscd]),
              class: "flex-1 inline-flex items-center justify-center px-6 py-2 text-base font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500" do %>
            <%= t('actions.back') %>
          <% end %>
          <%= f.submit t("#{scope}.continue"), class: "flex-1 inline-flex justify-center items-center px-4 py-2 border border-transparent text-base font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 cursor-pointer focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>
