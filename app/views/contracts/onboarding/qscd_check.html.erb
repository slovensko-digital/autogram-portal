<% content_for :title, t('.title') %>

<div class="mx-auto max-w-3xl">
  <div class="relative isolate overflow-hidden">
    <div class="mx-auto flex flex-col max-w-4xl space-y-6 px-6 pb-8 pt-10 lg:flex lg:px-8">
      <div>
        <h1 class="text-4xl font-bold text-gray-900 mb-2"><%= t('.title') %></h1>
        <p class="text-md text-gray-600 mb-4">
          <%= t('.description') %>
        </p>
      </div>

      <%= form_with url: contract_onboarding_path(@contract, @step), method: :patch do |f| %>
        <%= hidden_field_tag :recipient, @recipient&.uuid if @recipient %>
        <%= hidden_field_tag :method, @method %>
        <%= hidden_field_tag :review, params[:review] if params[:review] %>
        <%= hidden_field_tag :iframe, params[:iframe] %>

        <fieldset>
        <legend class="sr-only"><%= t('.title') %></legend>
        <h2 id="qscd_group_sk_eid_title" class="mb-3 text-sm font-semibold text-gray-700"><%= t('.sk_eid_title') %></h2>
        <div class="space-y-3" role="group" aria-labelledby="qscd_group_sk_eid_title">
          <% User::QSCD_GROUPS[:sk_eid].each do |value| %>
            <%= render "contracts/onboarding/qscd_option", value: value, selected: @selected_qscd, required: true %>
          <% end %>
        </div>

        <div class="mt-8 space-y-3">
          <% %i[sk_dpb cz_eid tokens].each do |group| %>
            <%= render "contracts/onboarding/qscd_group", group: group, selected: @selected_qscd, required: true %>
          <% end %>
        </div>
        </fieldset>

        <div class="mt-8 border-t border-gray-200"></div>

        <div class="mt-8 flex gap-8">
          <%# Changing the document returns to the signing apps; without one they would send the signer straight back here. %>
          <% back_path = if params[:review] == "true"
            signature_apps_contract_path(@contract, recipient: @recipient&.uuid, iframe: params[:iframe], qscd: params[:qscd])
          else
            signing_page_path(@contract, recipient: @recipient, iframe: params[:iframe])
          end %>
          <%= link_to back_path,
              class: "btn btn-secondary flex-1" do %>
            <%= t('actions.back') %>
          <% end %>
          <%= f.submit t('.continue'), class: "btn btn-primary flex-1" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
