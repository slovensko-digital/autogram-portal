<%# locals: (contract:, recipient: nil, heading_level: 3) %>

<%# The signing apps depend on the signer's document, so they stay disabled until it is picked in onboarding. %>
<% onboarding_path = contract_onboarding_path(contract, "qscd_check", method: "electronic", recipient: recipient&.uuid, iframe: params[:iframe]) %>

<div class="space-y-5">
  <div class="w-full space-y-1">
    <%= content_tag "h#{heading_level}", t("contracts.signature_apps.title"), class: "text-lg font-semibold text-gray-900" %>
    <p class="text-sm text-gray-600"><%= t("contracts.signature_apps.subtitle") %></p>
  </div>

  <%= link_to onboarding_path, data: { turbo_frame: "_top" },
        class: "group block rounded-lg border border-blue-600 bg-blue-50 p-2 transition-all hover:border-blue-700 hover:bg-blue-100" do %>
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-6">
        <div class="flex-shrink-0">
          <%= image_tag "qscd/smart_card.svg", alt: "", class: "h-24 w-auto rounded-md" %>
        </div>
        <div>
          <div class="text-sm font-medium text-gray-900"><%= t(".title") %></div>
          <div class="mt-1 text-xs text-gray-600"><%= t(".description") %></div>
        </div>
      </div>
      <div class="flex-shrink-0">
        <svg aria-hidden="true" class="mx-4 h-6 w-6 text-blue-600 transition-colors group-hover:text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </div>
    </div>
  <% end %>

  <%= render "contracts/signature_app_options", contract: contract, recipient: recipient, qscd: nil, preview: true %>

  <%= link_to t(".action"),
        onboarding_path,
        data: { turbo_frame: "_top" },
        class: "inline-flex w-full items-center justify-center rounded-md border border-transparent bg-blue-600 px-4 py-2 text-base font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
</div>
