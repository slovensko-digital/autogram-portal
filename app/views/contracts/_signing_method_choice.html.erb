<%# locals: (contract:, recipient: nil, heading_level: 3) %>

<% signing_methods = contract.signing_methods_for(recipient: recipient) %>
<% qscd = params[:qscd].presence || current_user&.qscd || cookies[:qscd] %>
<% electronic_path = if contract.prepared_signature_field_appearance_required_for?(recipient: recipient)
  visual_signing_contract_path(contract, recipient: recipient&.uuid, iframe: params[:iframe], purpose: "signature_field_appearance")
else
  signature_apps_contract_path(contract, recipient: recipient&.uuid, iframe: params[:iframe], qscd: qscd.presence)
end %>

<div data-controller="signing-method" class="w-full space-y-4">
  <fieldset>
    <legend class="mb-4"><%= content_tag "h#{heading_level}", t('.title'), class: "text-lg font-semibold text-gray-900" %></legend>
    <div class="space-y-3">
      <% if signing_methods.include?("electronic") %>
        <%= render 'shared/radio_button_card',
              name: "signing_method_#{contract.uuid}",
              value: 'electronic',
              label: t('.electronic_label'),
              description: t('.electronic_description'),
              checked: true,
              icon: 'mobile',
              data_attributes: {
                signing_method_target: 'methodRadio',
                action: 'change->signing-method#handleMethodSelection'
              } %>
      <% end %>

      <% if signing_methods.include?("ades") %>
        <%= render 'shared/radio_button_card',
              name: "signing_method_#{contract.uuid}",
              value: 'ades',
              label: t('.ades_label'),
              description: t('.ades_description'),
              checked: (signing_methods & %w[electronic physical visual]).empty?,
              icon: 'mobile',
              data_attributes: {
                signing_method_target: 'methodRadio',
                action: 'change->signing-method#handleMethodSelection'
              } %>
      <% end %>

      <% if signing_methods.include?("physical") %>
        <%= render 'shared/radio_button_card',
              name: "signing_method_#{contract.uuid}",
              value: 'physical',
              label: t('.physical_label'),
              description: t('.physical_description'),
              checked: false,
              icon: 'pencil',
              data_attributes: {
                signing_method_target: 'methodRadio',
                action: 'change->signing-method#handleMethodSelection'
              } %>
      <% end %>

      <% if signing_methods.include?("visual") %>
        <%= render 'shared/radio_button_card',
              name: "signing_method_#{contract.uuid}",
              value: 'visual',
              label: t('.visual_label'),
              description: t('.visual_description'),
              checked: (signing_methods & %w[electronic physical]).empty?,
              icon: 'pencil',
              data_attributes: {
                signing_method_target: 'methodRadio',
                action: 'change->signing-method#handleMethodSelection'
              } %>
      <% end %>
    </div>
  </fieldset>

  <div class="hidden">
    <% if signing_methods.include?("electronic") %>
      <%= link_to "",
          electronic_path,
          data: { signing_method_target: 'electronicButton', turbo_frame: "_top" } %>
    <% end %>

    <% if signing_methods.include?("ades") %>
      <%= link_to "",
          ades_contract_sessions_path(contract, recipient: recipient&.uuid, iframe: params[:iframe]),
          data: { signing_method_target: 'adesButton', turbo_frame: "_top" } %>
    <% end %>

    <% if signing_methods.include?("physical") %>
      <%= link_to "",
          physical_signing_contract_path(contract, recipient: recipient&.uuid, iframe: params[:iframe]),
          data: { signing_method_target: 'physicalButton', turbo_frame: "_top" } %>
    <% end %>

    <% if signing_methods.include?("visual") %>
      <%= link_to "",
          visual_signing_contract_path(contract, recipient: recipient&.uuid, iframe: params[:iframe]),
          data: { signing_method_target: 'visualButton', turbo_frame: "_top" } %>
    <% end %>
  </div>

  <div class="flex justify-end">
    <button type="button"
            data-signing-method-target="continueButton"
            data-action="click->signing-method#continue"
            class="px-4 py-2 bg-blue-600 text-white rounded-md cursor-pointer hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
      <%= t('.continue') %>
    </button>
  </div>
</div>
