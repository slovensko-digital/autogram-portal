<%# locals: (previous_page: root_path) %>

<%= turbo_frame_tag "contract_actions_#{@contract.uuid}" do %>
  <% anonymous_account_teaser = current_user.nil? && @contract.anonymous? %>
  <% contract_policy = policy(@contract) %>
  <% managed_contract = contract_policy.manage? %>
  <div class="w-full" data-controller="radio-link" data-action="change->radio-link#updateLink">
    <div class="mb-6 text-center lg:text-left">
      <h3 class="text-lg font-semibold text-gray-900 mb-2"><%= t('documents.new.actions.header') %></h3>
    </div>
    <div class="space-y-3">
      <%= render 'shared/radio_button_card',
            name: 'document_action',
            value: 'sign',
            label: t('documents.new.actions.sign.title'),
            description: t('documents.new.actions.sign.subtitle'),
            checked: true,
            data_attributes: {
              url: signature_parameters_contract_path(@contract, target_step: 'sign')
            } %>

      <% if contract_policy.prepare_signature_fields? && @contract.pades_field_preparation_allowed? %>
        <%= render 'shared/radio_button_card',
              name: 'document_action',
              value: 'prepare_signature_fields',
              label: t('documents.new.actions.prepare_signature_fields.title'),
              description: t('documents.new.actions.prepare_signature_fields.subtitle'),
              checked: false,
              data_attributes: {
                url: contract_signature_field_preparations_path(@contract)
              } %>
      <% end %>

      <% if anonymous_account_teaser %>
        <%= render 'shared/radio_button_card',
          name: 'document_action',
          value: 'request_signature',
          label: t('documents.new.actions.request_signature.title'),
          description: t('documents.new.actions.request_signature.subtitle'),
          disabled: true,
          disabled_reasons: [t('documents.new.actions.account_required')] %>

        <%= render 'shared/radio_button_card',
          name: 'document_action',
          value: 'add_timestamp',
          label: t('documents.new.actions.add_timestamp.title'),
          description: t('documents.new.actions.add_timestamp.subtitle'),
          disabled: true,
          disabled_reasons: [t('documents.new.actions.account_required')] %>

        <%= render 'shared/radio_button_card',
          name: 'document_action',
          value: 'archive_signature',
          label: t('documents.new.actions.archive.title'),
          description: t('documents.new.actions.archive.subtitle'),
          disabled: true,
          disabled_reasons: [t('documents.new.actions.account_required')] %>
      <% elsif managed_contract && @contract.bundle.nil? && @contract.tenant.signature_request_allowed? %>
        <%= render 'shared/radio_button_card',
              name: 'document_action',
              value: 'request_signature',
              label: t('documents.new.actions.request_signature.title'),
              description: t('documents.new.actions.request_signature.subtitle'),
              checked: false,
              data_attributes: {
                url: signature_parameters_contract_path(@contract, target_step: 'request_signature')
              } %>
      <% end %>

      <% if managed_contract && @contract.tenant.signature_extension_allowed? && @contract.extendable_signatures?(target_level: 'T') %>
        <%= render 'shared/radio_button_card',
              name: 'document_action',
              value: 'add_timestamp',
              label: t('documents.new.actions.add_timestamp.title'),
              description: t('documents.new.actions.add_timestamp.subtitle'),
              checked: false,
              data_attributes: {
                url: signature_extension_contract_path(@contract, target_level: 'T')
              } %>
      <% end %>

      <% if managed_contract && @contract.tenant.signature_extension_allowed? && @contract.extendable_signatures?(target_level: 'LTA') %>
        <%= render 'shared/radio_button_card',
              name: 'document_action',
              value: 'archive_signature',
              label: t('documents.new.actions.archive.title'),
              description: t('documents.new.actions.archive.subtitle'),
              checked: false,
              data_attributes: {
                url: signature_extension_contract_path(@contract, target_level: 'LTA')
              } %>
      <% end %>

      <% if anonymous_account_teaser %>
        <div class="rounded-md border border-blue-200 bg-blue-50 px-4 py-3">
          <p class="text-sm text-gray-700"><%= t('documents.new.actions.account_cta_text') %></p>
          <%= button_to t('documents.new.actions.account_cta'),
                authenticate_for_actions_contract_path(@contract),
                class: "mt-3 inline-flex w-full items-center justify-center rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 sm:w-auto",
                form: { data: { turbo_frame: "_top" } } %>
        </div>
      <% end %>
    </div>
    <div class="py-8">
      <div class="flex flex-col sm:flex-row gap-8">
        <%= link_to contract_path(@contract), class: "flex-1 inline-flex justify-center items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500", data: {turbo_frame: "_top"} do %>
          <%= t('documents.new.actions.back') %>
        <% end %>
        <%= link_to signature_parameters_contract_path(@contract, target_step: 'sign'),
              class: "flex-1 inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500",
              data: {
                turbo_frame: "_self",
                "radio-link-target": "link"
              } do %>
          <%= t('documents.new.actions.continue') %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
