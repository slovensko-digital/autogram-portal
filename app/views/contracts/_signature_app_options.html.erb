<%# locals: () %>

<%
  signing_apps = [
    {
      session_class: AutogramSession,
      allowed_method: "qes",
      value: "autogram",
      label: t("contracts.signature_apps.autogram_desktop_label"),
      description: t("contracts.signature_apps.autogram_desktop_description"),
      icon: "desktop",
      desktop_only: true
    },
    {
      session_class: AvmSession,
      allowed_method: "qes",
      value: "avm",
      label: t("contracts.signature_apps.autogram_mobile_label"),
      description: t("contracts.signature_apps.autogram_mobile_description"),
      icon: "mobile",
      desktop_only: false
    },
    {
      session_class: EidentitaSession,
      allowed_method: "qes",
      value: "eidentita",
      label: t("contracts.signature_apps.eidentita_label"),
      description: t("contracts.signature_apps.eidentita_description"),
      icon: "mobile",
      desktop_only: false
    },
    {
      session_class: PodpisujSession,
      allowed_method: "standalone_qes",
      value: "podpisuj",
      label: t("contracts.signature_apps.podpisuj_label"),
      description: t("contracts.signature_apps.podpisuj_description"),
      icon: "pencil",
      desktop_only: true
    }
  ]

  signing_apps.select! { |app| @contract.allowed_methods.include?(app[:allowed_method]) }

  # Only the author of a standalone contract can change its signature format, so
  # apps that cannot sign the requested format are shown (disabled) only to them.
  unless @contract.bundle.nil? && params[:iframe].blank?
    signing_apps.reject! do |app|
      app[:session_class].unavailability_reasons(@qscd, @contract).intersect?(Session::SIGNATURE_FORMAT_UNAVAILABILITY_REASONS)
    end
  end
  # Podpisuj (and other standalone apps) goes after the last available app, but still before the unavailable ones.
  podpisuj_app = signing_apps.find { |app| app[:value] == "podpisuj" }
  if podpisuj_app&.dig(:session_class)&.available?(@qscd, @contract)
    signing_apps.delete(podpisuj_app)
    last_available_index = signing_apps.rindex { |app| app[:session_class].available?(@qscd, @contract) }
    signing_apps.insert(last_available_index ? last_available_index + 1 : 0, podpisuj_app)
  end
  available_app_values = signing_apps.select { |app| app[:session_class].available?(@qscd, @contract) }.map { |app| app[:value] }
  first_available_app = signing_apps.find { |app| available_app_values.include?(app[:value]) }
%>

<fieldset class="space-y-3">
  <legend class="sr-only"><%= t("contracts.signature_apps.title") %></legend>
  <% signing_apps.each do |app| %>
    <%
      reason_keys = app[:session_class].unavailability_reasons(@qscd, @contract)
      reasons = reason_keys.map do |reason|
        t("contracts.signature_apps.unavailable_reasons.#{reason}", qscd: (@qscd.present? ? t("qscd.title.#{@qscd}") : nil))
      end
    %>
    <%= render "shared/radio_button_card",
          name: "signing_app_#{@contract.uuid}",
          value: app[:value],
          label: app[:label],
          description: app[:description],
          checked: app == first_available_app,
          disabled: reasons.any?,
          disabled_reasons: reasons,
          icon: app[:icon],
          data_attributes: {
            signing_app_selector_target: "appRadio",
            desktop_only: app[:desktop_only],
            desktop_only_reason: t("contracts.signature_apps.unavailable_reasons.desktop_only")
          } %>
  <% end %>
</fieldset>

<% if available_app_values.intersect?(%w[avm eidentita]) && !params[:iframe] %>
  <%= render "shared/info",
        title: t("contracts.signature_apps.third_party_notice_title"),
        content: t("contracts.signature_apps.third_party_notice") %>
<% end %>

<div class="hidden">
  <% signing_apps.each do |app| %>
    <% next unless available_app_values.include?(app[:value]) %>
    <%= link_to "",
          public_send("#{app[:value]}_contract_sessions_path", @contract,
            recipient: @recipient,
            iframe: params[:iframe],
            embedded: params[:embedded],
            skip_method_choice: params[:skip_method_choice]),
          data: {
            turbo_frame: "signature_apps_#{@contract.uuid}",
            signing_app_selector_target: "#{app[:value]}SubmitButton"
          } %>
  <% end %>
</div>
