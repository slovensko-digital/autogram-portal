<%# locals: (back_path:, retry_path: nil) %>
<% expired = !@session.failed? %>
<% title_id = dom_id(@session, :error_title) %>
<% description_id = dom_id(@session, :error_description) %>

<div class="w-full px-4 py-10 sm:px-6 sm:py-16">
  <div class="mx-auto w-full max-w-xl rounded-lg border border-gray-200 bg-white px-6 py-8 text-center shadow-sm sm:px-10">
    <div aria-hidden="true" class="mx-auto flex h-14 w-14 items-center justify-center rounded-full <%= expired ? "bg-amber-100" : "bg-red-100" %>">
      <% if expired %>
        <svg class="h-7 w-7 text-amber-700" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      <% else %>
        <svg class="h-7 w-7 text-red-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
        </svg>
      <% end %>
    </div>

    <%# The page replaces the signing app in a broadcast, so focus moves to the result and screen readers read it. %>
    <h1 id="<%= title_id %>" tabindex="-1" aria-describedby="<%= description_id %>" data-controller="focus-on-connect"
        class="mt-5 text-2xl font-bold tracking-tight text-gray-900 focus:outline-none">
      <%= expired ? t(".expired_title") : t(".title") %>
    </h1>

    <div id="<%= description_id %>">
      <p class="mt-3 text-base text-gray-600"><%= expired ? t(".expired_description") : t(".description") %></p>

      <% if @session.error_message.present? %>
        <div class="mt-6 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-left">
          <p class="text-sm font-semibold text-red-900"><%= t(".reason") %></p>
          <p class="mt-1 text-sm text-red-800 break-words"><%= @session.error_message %></p>
        </div>
      <% end %>
    </div>

    <% if retry_path && !expired %>
      <p class="mt-6 text-sm text-gray-600"><%= t(".retry_hint") %></p>
    <% end %>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
      <% if retry_path %>
        <%= link_to retry_path,
              data: { turbo_frame: "signature_apps_#{@session.contract.uuid}" },
              class: "inline-flex items-center justify-center gap-2 rounded-md bg-blue-600 px-4 py-3 text-sm font-semibold text-white hover:bg-blue-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2" do %>
          <svg aria-hidden="true" class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
          </svg>
          <%= t(".retry") %>
        <% end %>
      <% end %>

      <%= link_to retry_path ? t(".choose_another_method") : t("actions.back"), back_path,
            data: { turbo: false },
            class: "inline-flex items-center justify-center rounded-md border border-gray-300 bg-white px-4 py-3 text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2" %>
    </div>
  </div>
</div>
<%= tag.div hidden: true, data: { controller: "parent-message", parent_message_payload_value: @session.error_event_payload, parent_message_key_value: "session-#{@session.id}-error" } %>
