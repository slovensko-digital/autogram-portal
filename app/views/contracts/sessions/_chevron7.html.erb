<% content_for :title, t('.title') %>

<div>
  <div class="px-6 py-5">
    <h1 class="text-3xl font-bold text-gray-900"><%= t('.title') %></h1>
    <p class="text-sm text-gray-600 mt-1"><%= t('.lead') %></p>
  </div>

  <div class="py-6 px-6">
    <div class="flex flex-col items-center space-y-6 bg-white md:border md:border-gray-200 md:rounded-lg md:p-6">
      <a href="<%= @session.chevron7_url %>" class="btn btn-primary" data-turbo="false"><%= t('.open') %></a>

      <div role="status" class="flex items-center gap-2 text-sm text-gray-600">
        <svg aria-hidden="true" class="animate-spin h-4 w-4 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none"></circle>
          <path class="opacity-75" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" d="M12 2 A 10 10 0 0 1 22 12"></path>
        </svg>
        <span><%= t('.waiting') %></span>
      </div>

      <p class="text-center text-sm text-gray-600 px-8"><%= t('.expiry') %></p>

      <p class="text-sm text-gray-600 text-center">
        <%= t('.not_installed') %>
        <%= link_to t('.download'), "https://chevron7.slovensko.app", target: "_blank", rel: "noopener", class: "text-blue-600 underline hover:text-blue-800" %>
      </p>
    </div>
  </div>
</div>
