<%# locals: (session:, recipient: @recipient, iframe: params[:iframe], embedded: params[:embedded], qscd: params[:qscd]) %>
<% @session ||= session %>
<% contract = @session.contract %>
<%= turbo_frame_tag "signature_apps_#{contract.uuid}" do %>
  <%=  turbo_stream_from @session %>
  <div class="mx-auto flex max-w-4xl flex-col items-center space-y-6 lg:flex">
    <div class="relative isolate overflow-hidden">
      <% if @session.signed? %>
        <%= render "contracts/sessions/signed" %>
      <% elsif @session.failed? || @session.expired? %>
        <%= render "contracts/sessions/error" %>
      <% elsif @session.eidentita? %>
        <%= render "contracts/sessions/eidentita" %>
      <% elsif @session.avm? %>
        <%= render "contracts/sessions/avm" %>
      <% elsif @session.autogram? %>
        <%= render "contracts/sessions/autogram" %>
      <% elsif @session.ades_evidence? %>
        <%= render "contracts/sessions/ades_evidence" %>
      <% elsif @session.podpisuj? %>
        <%= render "contracts/sessions/podpisuj" %>
      <% end %>
      <!-- Footer with back button -->
      <div class="border-t border-gray-200 px-6 py-4">
        <%# Apps embedded in the signing page go back to that page, which offers them again. %>
        <% back_path = if @session.ades_evidence? || embedded.present?
          contract.bundle ? sign_bundle_path(contract.bundle, recipient: recipient&.uuid, iframe: iframe, qscd: qscd) : sign_contract_path(contract, recipient: recipient&.uuid, iframe: iframe, qscd: qscd)
        else
          signature_apps_contract_path(contract, recipient: recipient, iframe: iframe, qscd: qscd)
        end %>

        <%= link_to back_path,
                    class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500",
                    data: { turbo: false } do %>
          <%= t('actions.back') %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
