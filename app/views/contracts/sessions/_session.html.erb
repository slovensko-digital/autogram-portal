<%# locals: (session:, recipient: @recipient, iframe: params[:iframe], qscd: params[:qscd]) %>
<% @session ||= session %>
<% contract = @session.contract %>
<%= turbo_frame_tag "signature_apps_#{contract.uuid}" do %>
  <% if @session.pending? %>
    <%= turbo_stream_from @session, data: {
          controller: "session-state",
          session_state_url_value: state_contract_session_path(contract, @session, session_token: SessionAccessToken.generate(contract: contract, session: @session))
        } %>
  <% else %>
    <%= turbo_stream_from @session %>
  <% end %>
  <% back_path = if @session.ades_evidence?
    signing_page_path(contract, recipient: recipient, iframe: iframe, qscd: qscd)
  else
    signature_apps_contract_path(contract, recipient: recipient, iframe: iframe, qscd: qscd)
  end %>
  <% unsuccessful = !@session.signed? && (@session.failed? || @session.expired?) %>
  <div class="mx-auto flex max-w-4xl flex-col items-center space-y-6 lg:flex">
    <div class="relative isolate overflow-hidden">
      <% if @session.signed? %>
        <%= render "contracts/sessions/signed" %>
      <% elsif unsuccessful %>
        <%= render "contracts/sessions/error",
              back_path: back_path,
              retry_path: (restart_session_path(@session, recipient: recipient, iframe: iframe, qscd: qscd) if @session.signer_contract.awaiting?) %>
      <% elsif @session.eidentita? %>
        <%= render "contracts/sessions/eidentita" %>
      <% elsif @session.avm? %>
        <%= render "contracts/sessions/avm" %>
      <% elsif @session.autogram? %>
        <%= render "contracts/sessions/autogram" %>
      <% elsif @session.ades_evidence? %>
        <%= render "contracts/sessions/ades_evidence" %>
      <% elsif @session.podpisuj? %>
        <%= render "contracts/sessions/podpisuj" %>
      <% end %>
      <% unless unsuccessful %>
        <!-- Footer with back button -->
        <div class="border-t border-gray-200 px-6 py-4">
          <%= link_to back_path,
                      class: "btn btn-secondary",
                      data: { turbo: false } do %>
            <%= t('actions.back') %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
