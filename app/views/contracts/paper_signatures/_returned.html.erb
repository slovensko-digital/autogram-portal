<%# locals: (paper_signature:) %>
<div class="w-full rounded-lg border border-red-300 bg-red-50 p-4" role="alert">
  <div class="flex items-start">
    <svg aria-hidden="true" class="h-5 w-5 flex-shrink-0 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
    </svg>
    <div class="ml-3 min-w-0 flex-1">
      <p class="mb-1 text-sm font-semibold text-red-900"><%= t('paper_signatures.returned.title') %></p>
      <p class="whitespace-pre-line break-words text-sm text-red-800"><%= paper_signature.return_reason %></p>
      <p class="mt-2 text-xs text-red-700">
        <%= t('paper_signatures.returned.reviewed', name: paper_signature_reviewer_name(paper_signature), time: l(paper_signature.reviewed_at, format: :short)) %>
      </p>
    </div>
  </div>
</div>
