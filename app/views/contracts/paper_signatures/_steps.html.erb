<%# locals: (contract:, paper_signature:) %>
<% document = contract.documents.first %>
<% step_number_classes = "flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-600 text-sm font-semibold text-white" %>

<ol class="divide-y divide-gray-200 rounded-xl border border-gray-200 bg-white">
  <li class="flex gap-4 p-5">
    <span class="<%= step_number_classes %>" aria-hidden="true">1</span>
    <div class="min-w-0 flex-1">
      <h2 class="text-base font-semibold text-gray-900"><%= t('paper_signatures.steps.download.title') %></h2>
      <p class="mt-1 break-words text-sm text-gray-600"><%= document.filename %></p>
      <%# The original document: a signed version would print the signatures of others. %>
      <%= link_to download_document_path(document), class: "btn btn-second-primary mt-3", data: { turbo: false } do %>
        <svg aria-hidden="true" class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
        <%= t('paper_signatures.steps.download.button') %>
      <% end %>
    </div>
  </li>

  <li class="flex gap-4 p-5">
    <span class="<%= step_number_classes %>" aria-hidden="true">2</span>
    <div class="min-w-0 flex-1">
      <h2 class="text-base font-semibold text-gray-900"><%= t('paper_signatures.steps.sign.title') %></h2>
      <p class="mt-1 text-sm text-gray-600"><%= t('paper_signatures.steps.sign.description') %></p>
    </div>
  </li>

  <li class="flex gap-4 p-5">
    <span class="<%= step_number_classes %>" aria-hidden="true">3</span>
    <div class="min-w-0 flex-1 space-y-5">
      <h2 class="text-base font-semibold text-gray-900"><%= t('paper_signatures.steps.upload.title') %></h2>

      <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_16rem]">
        <%= form_with url: contract_paper_signature_pages_path(contract, **paper_signer_link_params), multipart: true, class: "space-y-3",
                      data: { controller: "paper-pages", paper_pages_failed_value: t('paper_signatures.steps.upload.failed'), action: "change->paper-pages#pick dragover->paper-pages#dragOver dragleave->paper-pages#dragLeave drop->paper-pages#drop" } do %>
          <label for="paper_signature_files"
                 class="flex min-h-48 w-full cursor-pointer flex-col items-center justify-center rounded-lg border-2 border-dashed border-gray-500 bg-gray-50/30 px-6 py-8 text-center transition-all duration-200 hover:border-gray-600 hover:bg-gray-50/50 data-[dragging]:border-blue-600 data-[dragging]:bg-blue-50"
                 data-paper-pages-target="dropzone">
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-10 w-10 text-gray-400">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
            </svg>
            <span class="mt-3 text-base font-semibold text-gray-700"><%= t('paper_signatures.steps.upload.dropzone_title') %></span>
            <span class="mt-2 text-sm text-gray-600"><%= t('paper_signatures.steps.upload.dropzone_subtitle') %></span>
            <span id="paper_signature_files_hint" class="mt-1.5 text-xs text-gray-600"><%= t('paper_signatures.steps.upload.file_types') %></span>
          </label>
          <%# Phones convert HEIC photos to JPEG for inputs that accept only JPEG and PNG. %>
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
            <%= file_field_tag "files[]",
                  id: "paper_signature_files",
                  multiple: true,
                  accept: "application/pdf,image/jpeg,image/png",
                  aria: { describedby: "paper_signature_files_hint" },
                  class: paper_file_input_classes %>
            <%= submit_tag t('paper_signatures.steps.upload.button'), name: nil, class: "btn btn-second-primary shrink-0", data: { paper_pages_target: "fallback" } %>
          </div>
          <%= render 'contracts/paper_signatures/upload_feedback' %>
        <% end %>

        <%= render 'contracts/paper_signatures/phone', contract: contract, paper_signature: paper_signature %>
      </div>

      <%= render 'contracts/paper_signatures/pages', contract: contract, paper_signature: paper_signature, editable: true %>

      <%= render 'contracts/paper_signatures/page_count_warning', paper_signature: paper_signature %>
    </div>
  </li>
</ol>
