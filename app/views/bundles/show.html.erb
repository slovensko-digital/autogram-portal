<% content_for :title, @bundle.display_name %>

<%= turbo_stream_from @bundle %>
<% @bundle.contracts.each do |contract| %>
  <%= turbo_stream_from contract %>
<% end %>

<div>
  <div class="mx-auto max-w-4xl space-y-8 px-6 pb-24 pt-10 lg:px-8">
    <div>
      <%= link_to bundles_path, class: "inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800 hover:underline" do %>
        <svg aria-hidden="true" class="mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        <%= t('.all_bundles') %>
      <% end %>

      <div class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-3">
            <h1 class="text-3xl font-bold text-gray-900 break-words"><%= @bundle.display_name %></h1>
            <% case @bundle.bundle_state
               when :completed %>
              <%= render 'shared/badge', color: 'green', label: t('bundles.status.completed') %>
            <% when :declined %>
              <%= render 'shared/badge', color: 'red', label: t('bundles.status.declined') %>
            <% when :no_recipients %>
              <%= render 'shared/badge', color: 'gray', label: t('bundles.status.no_recipients') %>
            <% else %>
              <%= render 'shared/badge', color: 'yellow', label: t('bundles.status.awaiting_signature') %>
            <% end %>
          </div>
          <p class="mt-1 text-sm text-gray-500">
            #<%= @bundle.short_uuid %>
            &middot; <%= t('.created', date: @bundle.created_at.strftime("%d.%m.%Y")) %>
            &middot; <%= @bundle.contracts.size %> <%= t('document', count: @bundle.contracts.size) %>
          </p>
        </div>

        <div class="flex flex-col gap-2 sm:flex-row sm:shrink-0">
          <%= link_to t('actions.edit'), edit_bundle_path(@bundle),
                class: "btn btn-second-primary" %>
          <%= link_to t('actions.sign'), sign_bundle_path(@bundle),
                class: "btn btn-primary" %>
          <%= button_to t('actions.delete'), bundle_path(@bundle),
                method: :delete,
                form: { data: { turbo_confirm: t('bundles.destroy.confirm', name: @bundle.display_name) } },
                class: "btn btn-danger-secondary w-full sm:w-auto" %>
        </div>
      </div>
    </div>

    <%# A scan of a document signed on paper counts only after a member approved it. %>
    <% paper_signatures_awaiting_review(@bundle).each do |paper_signature| %>
      <div class="flex flex-wrap items-center justify-between gap-4 rounded-lg border border-blue-200 bg-blue-50 px-5 py-4">
        <div class="flex min-w-0 flex-1 basis-80 items-start gap-3">
          <span aria-hidden="true" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white text-blue-700">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
            </svg>
          </span>
          <div class="min-w-0">
            <h2 class="break-words font-semibold text-blue-900"><%= t('paper_signatures.review.alert.title', name: paper_signature.signer.display_name) %></h2>
            <% if @bundle.contracts.size > 1 %>
              <p class="mt-1 break-words text-sm font-medium text-blue-900"><%= paper_signature.contract.display_name %></p>
            <% end %>
            <p class="mt-1 text-sm leading-6 text-blue-900"><%= t('paper_signatures.review.alert.message') %></p>
          </div>
        </div>
        <%= link_to bundle_paper_signature_path(@bundle, paper_signature), class: "btn btn-primary" do %>
          <%= t('paper_signatures.review.check') %><span class="sr-only">: <%= paper_signature.signer.display_name %></span>
        <% end %>
      </div>
    <% end %>

    <%= render "shared/retention_notice", record: @bundle %>

    <% if @bundle.note.present? %>
      <div class="flex items-start justify-between gap-4 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3">
        <div class="min-w-0">
          <h2 class="text-base font-medium text-gray-900"><%= t('.note_title') %></h2>
          <p class="mt-1 text-base text-gray-800 whitespace-pre-line break-words"><%= @bundle.note %></p>
        </div>
        <%= link_to edit_bundle_path(@bundle), class: "inline-flex min-h-6 shrink-0 items-center rounded-sm text-base font-medium text-blue-700 underline underline-offset-2 hover:text-blue-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" do %>
          <%= t('.edit_note') %><span class="sr-only">: <%= t('.note_title') %></span>
        <% end %>
      </div>
    <% end %>

    <section class="space-y-4">
      <h2 class="text-xl font-semibold text-gray-900"><%= t('.contracts_title') %></h2>
      <% @bundle.contracts.each do |contract| %>
        <%= turbo_frame_tag contract, src: show_bundle_contract_path(contract), loading: "lazy", class: "block w-full border border-gray-200 p-4 rounded-lg bg-white" do %>
          <%= render "bundles/loading", message: t('.loading_documents') %>
        <% end %>
      <% end %>
    </section>

    <section class="sm:rounded-lg sm:border sm:border-gray-200 sm:bg-white sm:p-6">
      <%= turbo_frame_tag "bundle_recipients_#{@bundle.uuid}", src: bundle_recipients_path(@bundle), loading: "lazy", class: "block w-full" do %>
        <%= render "bundles/loading", message: t('.loading_recipients') %>
      <% end %>
    </section>

    <% if @bundle.publicly_visible? %>
      <section class="rounded-lg border border-gray-200 bg-white p-6">
        <h2 class="text-xl font-semibold text-gray-900"><%= t('.public_link_title') %></h2>
        <p class="mt-1 text-sm text-gray-600"><%= t('.public_link_subtitle') %></p>
        <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:items-center"
             data-controller="clipboard"
             data-clipboard-text-value="<%= sign_bundle_url(@bundle) %>">
          <input type="text" readonly value="<%= sign_bundle_url(@bundle) %>"
                 data-action="click->clipboard#select"
                 aria-label="<%= t('.public_link_title') %>"
                 class="w-full flex-1 rounded-md border border-gray-500 bg-gray-50 px-3 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500" />
          <%= button_tag type: "button",
                data: { action: "clipboard#copyToClipboard" },
                class: "btn btn-second-primary" do %>
            <span data-clipboard-target="label"><%= t('.copy_link') %></span>
          <% end %>
          <span role="status" class="sr-only" data-clipboard-target="status"></span>
        </div>
      </section>
    <% end %>
  </div>
</div>
