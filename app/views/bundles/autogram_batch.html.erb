<% content_for :title, t('.title') + " ##{@bundle.short_uuid}" %>

<div>
  <div class="relative isolate overflow-hidden">
    <div class="mx-auto flex max-w-4xl flex-col items-center px-6 pb-8 pt-10 lg:px-8">
      <%= render "bundles/autogram_batch_signing",
            items: @batch_items,
            return_path: @return_path,
            back_label: t('.back_to_bundle'),
            title: t('.title'),
            subtitle: t('.subtitle', count: @batch_items.count),
            bundle: @bundle,
            iframe: params[:iframe].present? %>
      </div>
    </div>
  </div>
</div>