<% input_class = "w-full px-3 py-2 bg-white border border-gray-500 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500" %>
<% recipients_count = @bundle.visible_recipients.active.size %>
<%# A bundle without recipients is still being prepared: the author names it before adding recipients. %>
<% preparing = recipients_count.zero? %>
<% invited_recipients = @bundle.visible_recipients.active.where(notification_status: %i[sending notified]).order(:created_at).to_a %>

<% content_for :title, preparing ? t('.preparing_title') : t('.title') %>

<div>
  <div class="mx-auto max-w-4xl px-6 pb-24 pt-10 lg:px-8">
    <%= link_to (preparing ? bundles_path : bundle_path(@bundle)), class: "inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800 hover:underline" do %>
      <svg aria-hidden="true" class="mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
      </svg>
      <%= preparing ? t('bundles.show.all_bundles') : t('.back') %>
    <% end %>

    <div class="mt-4 mb-6">
      <% if preparing %>
        <h1 class="text-3xl font-bold text-gray-900"><%= t('.preparing_title') %></h1>
        <p class="mt-1 text-gray-600"><%= t('.preparing_subtitle') %></p>
        <p class="mt-2 flex items-center gap-1.5 text-sm text-gray-600">
          <svg aria-hidden="true" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
          <span class="break-all"><%= @bundle.contracts.map(&:display_name).join(", ") %></span>
        </p>
      <% else %>
        <h1 class="text-3xl font-bold text-gray-900"><%= t('.title') %></h1>
        <p class="mt-1 text-sm text-gray-600"><%= @bundle.display_name %></p>
      <% end %>
    </div>

    <% if @bundle.errors.any? %>
      <%= render "shared/error", title: t('.errors_title'), content: @bundle.errors.full_messages.to_sentence %>
    <% end %>

    <% if invited_recipients.any? %>
      <div class="mb-6 flex gap-3 rounded-lg border border-yellow-300 bg-yellow-50 px-4 py-4 text-yellow-900">
        <svg aria-hidden="true" class="mt-0.5 h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
        </svg>
        <div class="min-w-0 space-y-1.5">
          <h2 class="font-semibold"><%= t('.invited_warning_title', count: invited_recipients.size) %></h2>
          <p class="text-sm"><%= t('.invited_warning_description', count: invited_recipients.size) %></p>
          <p class="text-sm break-words"><%= invited_recipients.map(&:display_name).join(", ") %></p>
        </div>
      </div>
    <% end %>

    <%= form_with model: @bundle do |form| %>
      <div class="rounded-lg border border-gray-200 bg-white divide-y divide-gray-200">
        <div class="p-6">
          <%= form.label :name, t('.name_label'), class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :name, placeholder: @bundle.display_name, "aria-describedby": "bundle_name_help", class: "mt-2 #{input_class}" %>
          <p id="bundle_name_help" class="mt-2 text-sm text-gray-600"><%= t('.name_help') %></p>
        </div>

        <div class="p-6">
          <%= form.label :note, t('.note_label'), class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_area :note, rows: 5, placeholder: t('.note_placeholder'), "aria-describedby": "bundle_note_help", class: "mt-2 #{input_class}" %>
          <p id="bundle_note_help" class="mt-2 text-sm text-gray-600"><%= t('.note_help') %></p>
        </div>

        <%# With a single recipient every rule means the same, so the rule is offered from two recipients on. %>
        <% if recipients_count >= 2 %>
          <div class="p-6" data-controller="signing-rule" data-action="change->signing-rule#change">
            <fieldset>
              <legend class="text-sm font-medium text-gray-700"><%= t('.signing_rule_label') %></legend>
              <div class="mt-2 grid grid-cols-1 gap-2">
                <% %w[all any threshold].each do |rule| %>
                  <%= render 'shared/radio_button_card',
                        form: form,
                        name: :signing_rule,
                        value: rule,
                        label: t("recipients.index.signing_rule_#{rule}"),
                        description: t("recipients.index.signing_rule_#{rule}_description"),
                        checked: @bundle.signing_rule == rule %>
                <% end %>
              </div>
            </fieldset>
            <div data-signing-rule-target="thresholdField"
                 class="<%= 'hidden ' unless @bundle.signing_rule == 'threshold' %>mt-3 rounded-lg bg-gray-50 px-4 py-3">
              <%= form.label :required_signatures, t('.required_signatures_label'), class: "block text-sm font-medium text-gray-700" %>
              <div class="mt-2 flex items-center gap-2">
                <%= form.number_field :required_signatures, min: 1, max: recipients_count,
                      class: "w-20 px-2 py-1.5 text-sm bg-white border border-gray-500 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500" %>
                <span class="text-sm text-gray-600"><%= t('.required_signatures_of', count: recipients_count) %></span>
              </div>
            </div>
          </div>
        <% end %>

        <details class="group">
          <summary class="flex cursor-pointer items-center gap-2 px-6 py-4 text-sm hover:bg-gray-50 [list-style:none] [&::-webkit-details-marker]:hidden">
            <svg aria-hidden="true" class="h-4 w-4 shrink-0 text-gray-600 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
            <span class="font-medium text-gray-700"><%= t('.more_settings') %></span>
            <span class="text-gray-600">· <%= t('.more_settings_hint') %></span>
          </summary>

          <div class="px-6 pb-6 pt-2 space-y-4">
            <div class="flex items-start gap-3">
              <%= form.check_box :publicly_visible, class: "mt-1 h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
              <div>
                <%= form.label :publicly_visible, t('.public_link_label'), class: "block text-sm font-medium text-gray-900" %>
                <p class="text-sm text-gray-600"><%= t('.public_link_description') %></p>
                <% if @bundle.publicly_visible? %>
                  <input type="text" readonly value="<%= sign_bundle_url(@bundle) %>"
                         data-controller="clipboard" data-action="click->clipboard#select"
                         aria-label="<%= t('.public_link_label') %>"
                         class="mt-2 w-full rounded-md border border-gray-300 bg-gray-50 px-3 py-1.5 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <% end %>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <%= form.check_box :author_notifications_enabled, class: "mt-1 h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
              <div>
                <%= form.label :author_notifications_enabled, t('.author_notifications_label'), class: "block text-sm font-medium text-gray-900" %>
                <p class="text-sm text-gray-600"><%= t('.author_notifications_description') %></p>
              </div>
            </div>
          </div>
        </details>
      </div>

      <div class="mt-6 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
        <%= link_to t('.cancel'), bundle_path(@bundle),
              class: "btn btn-secondary" %>
        <%= form.submit (preparing ? t('.save_and_add_recipients') : t('actions.save')),
              class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
