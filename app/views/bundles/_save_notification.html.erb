<% error = local_assigns[:type] == :error %>
<div class="fixed inset-x-4 top-4 z-50 border-l-4 <%= error ? 'border-red-600 bg-red-50 text-red-900' : 'border-green-600 bg-green-50 text-green-900' %> p-4 shadow-lg transition duration-200 motion-reduce:transition-none sm:left-auto sm:right-6 sm:w-full sm:max-w-sm"
  role="<%= error ? 'alert' : 'status' %>"
     aria-live="polite"
     data-controller="notification"
     data-notification-overlay
     data-action="mouseenter->notification#pause mouseleave->notification#resume focusin->notification#pause focusout->notification#resume">
  <div class="flex items-center">
    <svg class="mr-3 h-6 w-6 flex-shrink-0 <%= error ? 'text-red-700' : 'text-green-700' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <% if error %>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      <% else %>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      <% end %>
    </svg>
    <p class="flex-1 font-semibold"><%= message %></p>
    <button type="button"
            class="ml-3 inline-flex p-1 <%= error ? 'text-red-800 hover:bg-red-100 focus:ring-red-700' : 'text-green-800 hover:bg-green-100 focus:ring-green-700' %> focus:outline-none focus:ring-2"
            data-action="notification#close"
            aria-label="<%= t('actions.close') %>">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</div>