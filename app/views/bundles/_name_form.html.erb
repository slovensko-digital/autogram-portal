<%= turbo_frame_tag "bundle_name_#{@bundle.uuid}", class: "w-full" do %>
  <% if @success_message.present? %>
    <%= render "save_notification", message: @success_message %>
  <% end %>
  <%= form_with model: @bundle,
                method: :put,
                local: true,
                data: {
                  controller: "form-submit",
                  action: "submit->form-submit#handleSubmit",
                  form_submit_pending_text_value: t("actions.saving")
                } do |form| %>
    <%= form.hidden_field :step, value: "name" %>
    <%= form.label :name, class: "flex items-center text-sm font-medium text-gray-700 mb-2" do %>
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.568 3.75H5.25A2.25 2.25 0 003 6v4.318c0 .597.237 1.17.659 1.591l8.932 8.932a2.25 2.25 0 003.182 0l4.318-4.318a2.25 2.25 0 000-3.182l-8.932-8.932a2.25 2.25 0 00-1.591-.659z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6.75 6.75h.008v.008H6.75V6.75z"/>
      </svg>
      <%= t('.label') %>
    <% end %>
    <%= form.text_field :name,
          placeholder: @bundle.display_name,
          class: "w-full px-3 py-2 bg-white border border-gray-300 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500" %>
    <div class="flex justify-end mt-4" style="justify-content: flex-end;">
      <%= form.submit t('actions.save'),
                      class: "items-center w-full sm:w-auto px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 cursor-pointer hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500",
                      data: { "form-submit-target": "submitButton" } %>
    </div>
  <% end %>
<% end %>