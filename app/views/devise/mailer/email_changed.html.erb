<%= render "mailer/badge", label: t(".badge"), tone: :amber %>
<% if @resource.try(:unconfirmed_email?) %>
  <%= render "mailer/heading", title: t(".title_unconfirmed"), message: t(".message_unconfirmed", email: @resource.unconfirmed_email) %>
<% else %>
  <%= render "mailer/heading", title: t(".title"), message: t(".message", email: @resource.email) %>
<% end %>
