<%= render "mailer/badge", label: t(".badge"), tone: :blue %>
<%= render "mailer/heading", title: t(".title"), message: t(".instruction", recipient: @resource.email) %>
<%= render "mailer/button", label: t(".action"), url: magic_link_url(@resource, @scope_name => { email: @resource.email, token: @token, remember_me: @remember_me }) %>
<%= render "mailer/hint", text: t(".expiry_notice", expiry: Devise.passwordless_login_within.inspect.to_i) %>
