     federation: "M7.5 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75h-1.5m-9 0a2.25 2.25 0 004.5 0m-4.5 0a2.25 2.25 0 014.5 0m0 0a2.25 2.25 0 004.5 0m-4.5 0h4.5",
     integration: "M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25M14.25 3l-4.5 18"
   } %>
<% subheading = "text-base font-semibold text-gray-900 mt-8 mb-3" %>
<% callout = "mt-6 rounded-xl border p-5" %>

<% contents = %w[documents-and-bundles organizations dashboard contracts signing bundles received archive account] %>
<% contents << "federation" if FederationConfiguration.enabled? %>
<% contents << "integration" %>

<div class="border-b border-gray-200 bg-white">
  <div class="mx-auto max-w-6xl px-6 py-12 lg:px-8 lg:py-16">
    <p class="flex items-center gap-2 text-sm font-semibold text-blue-700">
      <svg aria-hidden="true" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
      </svg>
      <%= t('.header.eyebrow') %>
    </p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-balance text-gray-900 lg:text-5xl"><%= t('.header.title') %></h1>
    <p class="mt-4 max-w-2xl text-lg leading-8 text-gray-600"><%= t('.header.subtitle') %></p>
  </div>
</div>

<%# Obsah je na širokej obrazovke prilepený vpravo vedľa textu, inak je to karta nad textom. Odkazy idú bez Turba,
    aby prehliadač presunul fokus na sekciu; aktuálnu sekciu označuje docs_contents_controller (aria-current). %>
<div class="mx-auto max-w-6xl px-6 py-12 lg:px-8 lg:py-16 xl:grid xl:grid-cols-[minmax(0,1fr)_12rem] xl:gap-x-12">
  <nav id="docs-contents" tabindex="-1" aria-labelledby="docs-contents-title" data-controller="docs-contents"
       class="mb-16 scroll-mt-8 rounded-xl border border-gray-200 bg-white p-5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600 xl:sticky xl:top-8 xl:col-start-2 xl:row-start-1 xl:mb-0 xl:self-start xl:rounded-none xl:border-0 xl:bg-transparent xl:p-0">
    <h2 id="docs-contents-title" class="text-sm font-semibold text-gray-900"><%= t('.nav.label') %></h2>
    <ul role="list" class="mt-3 grid gap-x-8 sm:grid-cols-2 xl:grid-cols-1 xl:border-l xl:border-gray-200">
      <% contents.each do |anchor| %>
        <li>
          <a href="#<%= anchor %>" data-turbo="false" data-docs-contents-target="link"
             class="block py-1.5 text-sm text-gray-700 underline-offset-4 hover:text-blue-700 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 aria-[current=true]:font-semibold aria-[current=true]:text-blue-700 aria-[current=true]:underline xl:-ml-px xl:border-l xl:border-transparent xl:pl-4 xl:text-gray-600 xl:hover:border-gray-400 xl:aria-[current=true]:border-blue-700 xl:aria-[current=true]:text-blue-700"><%= t(".nav.#{anchor.underscore}") %></a>
        </li>
      <% end %>
    </ul>
  </nav>

  <div class="min-w-0 space-y-20 xl:col-start-1 xl:row-start-1">

    <%# ─── DOKUMENT A BALÍK ───────────────────────────────────── %>
    <%= docs_section "documents-and-bundles", title: t('.documents_and_bundles.title'), icon: icons[:bundle], color: "bg-blue-600" do %>
      <p class="text-gray-600 leading-7 mb-6"><%= t('.documents_and_bundles.intro') %></p>
      <%= render "shared/document_vs_bundle", horizontal_from: :xl %>
    <% end %>

    <hr class="border-gray-200">

    <%# ─── PRIHLÁSENIE A ORGANIZÁCIE ──────────────────────────── %>
    <%= docs_section "organizations", title: t('.organizations.title'), icon: icons[:organization], color: "bg-sky-700" do %>
      <p class="text-gray-600 leading-7"><%= t('.organizations.intro') %></p>

      <h3 class="<%= subheading %>"><%= t('.organizations.sign_in_title') %></h3>
      <%= render "docs/cards", items: t('.organizations.sign_in') %>

      <h3 class="<%= subheading %>"><%= t('.organizations.organizations_title') %></h3>
      <p class="text-sm text-gray-600 mb-4"><%= t('.organizations.organizations_intro') %></p>
      <%= render "docs/cards", items: t('.organizations.organizations') %>
      <%= docs_screenshot "tenant-selection", alt: t('.organizations.screenshot_alt'), caption: t('.organizations.screenshot_caption') %>

      <h3 class="<%= subheading %>"><%= t('.organizations.plans_title') %></h3>
      <p class="text-sm text-gray-600 mb-4">
        <%= t('.organizations.plans_intro') %>
        <% if pricing_url %>
          <%= link_to pricing_url, target: "_blank", rel: "noopener", class: "font-medium text-blue-700 underline hover:text-blue-900" do %><%= t('.organizations.pricing_link') %><%= docs_new_tab_hint %><% end %>
        <% end %>
      </p>
      <%= render "docs/cards", items: t('.organizations.plans') %>
    <% end %>

    <hr class="border-gray-200">

    <%# ─── DOMOV ──────────────────────────────────────────────── %>
    <%= docs_section "dashboard", title: t('.dashboard.title'), icon: icons[:dashboard], color: "bg-blue-600" do %>
      <p class="text-gray-600 leading-7 mb-6"><%= t('.dashboard.intro') %></p>
      <% stat_colors = {
           bundles: [ "border-blue-200 bg-blue-50", "bg-blue-500" ],
           contracts: [ "border-indigo-200 bg-indigo-50", "bg-indigo-500" ],
           sent: [ "border-green-200 bg-green-50", "bg-green-500" ],
           declined: [ "border-red-200 bg-red-50", "bg-red-500" ]
         } %>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% t('.dashboard.stats').each do |key, stat| %>
          <div class="rounded-xl border p-5 <%= stat_colors.dig(key, 0) %>">
            <dt class="flex items-center gap-3 text-sm font-semibold text-gray-900">
              <span aria-hidden="true" class="h-2.5 w-2.5 rounded-full shrink-0 <%= stat_colors.dig(key, 1) %>"></span>
              <%= stat[:label] %>
            </dt>
            <dd class="mt-1 pl-[1.375rem] text-sm text-gray-600"><%= stat[:description] %></dd>
          </div>
        <% end %>
      </dl>
      <p class="mt-3 text-sm text-gray-600"><%= t('.dashboard.stats_hint') %></p>

      <h3 class="<%= subheading %>"><%= t('.dashboard.sections_title') %></h3>
      <%= render "docs/list", items: t('.dashboard.sections') %>
      <div class="<%= callout %> border-blue-100 bg-blue-50">
        <p class="text-sm font-semibold text-blue-900 mb-1"><%= t('.dashboard.pro_title') %></p>
        <p class="text-sm text-blue-800"><%= t('.dashboard.pro_description') %></p>
      </div>
      <%= docs_screenshot "dashboard", alt: t('.dashboard.screenshot_alt'), caption: t('.dashboard.screenshot_caption') %>
    <% end %>

    <hr class="border-gray-200">

    <%# ─── DOKUMENTY ──────────────────────────────────────────── %>
    <%= docs_section "contracts", title: t('.contracts.title'), icon: icons[:document], color: "bg-indigo-600" do %>
      <p class="text-gray-600 leading-7"><%= t('.contracts.intro') %></p>
      <%= docs_screenshot "documents", alt: t('.contracts.screenshot_alt'), caption: t('.contracts.screenshot_caption') %>

      <h3 class="<%= subheading %>"><%= t('.contracts.states_title') %></h3>
      <%= render "docs/statuses", items: t('.contracts.states'), colors: { awaiting: :yellow, completed: :green } %>

      <h3 class="<%= subheading %>"><%= t('.contracts.upload_title') %></h3>
      <p class="text-sm text-gray-600"><%= t('.contracts.upload_description') %></p>
      <%= docs_screenshot "document-upload", alt: t('.contracts.upload_screenshot_alt'), caption: t('.contracts.upload_screenshot_caption') %>

      <h3 class="<%= subheading %>"><%= t('.contracts.detail_title') %></h3>
      <p class="text-sm text-gray-600"><%= t('.contracts.detail_description') %></p>
      <%= docs_screenshot "document-detail", alt: t('.contracts.detail_screenshot_alt'), caption: t('.contracts.detail_screenshot_caption') %>

      <h3 class="<%= subheading %>"><%= t('.contracts.actions_title') %></h3>
      <%= render "docs/list", items: t('.contracts.actions') %>
      <p class="mt-4 text-sm text-gray-600"><%= t('.contracts.actions_note') %></p>

      <div class="<%= callout %> border-green-100 bg-green-50">
        <p class="text-sm font-semibold text-green-900 mb-1"><%= t('.contracts.verify_title') %></p>
        <p class="text-sm text-green-800"><%= t('.contracts.verify_description') %></p>
      </div>
    <% end %>

    <hr class="border-gray-200">

    <%# ─── PODPISOVANIE ───────────────────────────────────────── %>
    <%= docs_section "signing", title: t('.signing.title'), icon: icons[:signing], color: "bg-green-600" do %>
      <p class="text-gray-600 leading-7"><%= t('.signing.intro') %></p>

      <h3 class="<%= subheading %>"><%= t('.signing.steps_title') %></h3>
      <%= render "docs/steps", steps: t('.signing.steps'), color: "bg-green-600" %>
      <%= docs_screenshot "signature-parameters", alt: t('.signing.parameters_screenshot_alt'), caption: t('.signing.parameters_screenshot_caption') %>
      <%= docs_screenshot "qscd-selection", alt: t('.signing.qscd_screenshot_alt'), caption: t('.signing.qscd_screenshot_caption') %>
      <%= docs_screenshot "signing-app-selection", alt: t('.signing.apps_screenshot_alt'), caption: t('.signing.apps_screenshot_caption') %>

      <h3 class="<%= subheading %>"><%= t('.signing.signature_levels_title') %></h3>
      <%= render "docs/cards", items: t('.signing.signature_levels') %>

      <h3 class="<%= subheading %>"><%= t('.signing.formats_title') %></h3>
      <p class="text-sm text-gray-600 mb-4"><%= t('.signing.formats_intro') %></p>
      <%= render "docs/cards", items: t('.signing.formats') %>

      <h3 class="<%= subheading %>"><%= t('.signing.allowed_methods_title') %></h3>
      <p class="text-sm text-gray-600 mb-4"><%= t('.signing.allowed_methods_intro') %></p>
      <%= render "docs/cards", items: t('.signing.allowed_methods') %>
      <p class="mt-4 text-sm text-gray-600"><%= t('.signing.allowed_methods_note') %></p>

      <h3 class="<%= subheading %>"><%= t('.signing.methods_title') %></h3>
      <dl class="space-y-3">
        <% t('.signing.methods').each_value do |method| %>
          <div class="rounded-xl border border-gray-200 bg-white p-4">
            <dt class="text-sm font-semibold text-gray-900"><%= method[:label] %></dt>
            <dd class="mt-1 text-sm text-gray-600"><%= method[:description] %></dd>
            <% if method[:links].present? %>
              <dd class="mt-3">
                <ul role="list" class="flex flex-wrap gap-2">
                  <% method[:links].each_value do |link| %>
                    <li>
                      <a href="<%= link[:url] %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-md border border-blue-200 bg-blue-50 px-3 py-1.5 text-xs font-medium text-blue-700 underline underline-offset-2 hover:bg-blue-100 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"><%= link[:label] %><%= docs_new_tab_hint %></a>
                    </li>
                  <% end %>
                </ul>
              </dd>
            <% end %>
          </div>
        <% end %>
      </dl>
      <p class="mt-4 text-sm text-gray-600"><%= t('.signing.third_party_note') %></p>

      <h3 class="<%= subheading %>"><%= t('.signing.more_title') %></h3>
      <%= render "docs/cards", items: t('.signing.more') %>
      <p class="mt-4 text-sm text-gray-600">
        <%= t('.signing.evidence_verification_html', link: link_to(t('.signing.evidence_verification_link'), signature_evidence_verification_path, class: "font-medium text-blue-700 underline hover:text-blue-900")) %>
      </p>

      <h3 class="<%= subheading %>"><%= t('.signing.qualified_signing_title') %></h3>
      <p class="text-sm text-gray-600 mb-4"><%= t('.signing.qualified_signing_intro') %></p>
      <ul role="list" class="list-disc pl-5 space-y-2 text-sm text-gray-600 mb-6">
        <% t('.signing.qualified_signing_checks').each_value do |check| %>
          <li><%= check %></li>
        <% end %>
      </ul>

      <h4 class="text-sm font-semibold text-gray-900 mb-3"><%= t('.signing.qscd_cards_title') %></h4>
      <% qscd_support = { mobile: :green, desktop: :yellow, unsupported: :red } %>
      <dl class="space-y-3">
        <% t('.signing.qscd_cards').each_value do |card| %>
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1 rounded-xl border border-gray-200 bg-white p-4">
            <dt class="text-sm font-semibold text-gray-900"><%= card[:label] %></dt>
            <dd><%= docs_status_badge(t(".signing.qscd_support.#{card[:support]}"), qscd_support.fetch(card[:support].to_sym)) %></dd>
            <dd class="basis-full text-sm text-gray-600"><%= card[:description] %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>

    <hr class="border-gray-200">

    <%# ─── BALÍKY ─────────────────────────────────────────────── %>
    <%= docs_section "bundles", title: t('.bundles.title'), icon: icons[:bundle], color: "bg-blue-600" do %>
      <p class="text-gray-600 leading-7"><%= t('.bundles.intro') %></p>
      <%= docs_screenshot "bundles", alt: t('.bundles.screenshot_alt'), caption: t('.bundles.screenshot_caption') %>

      <h3 class="<%= subheading %>"><%= t('.bundles.lifecycle_title') %></h3>
      <%= render "docs/steps", steps: t('.bundles.lifecycle') %>
      <%= docs_screenshot "bundle-detail", alt: t('.bundles.detail_screenshot_alt'), caption: t('.bundles.detail_screenshot_caption') %>

      <h3 class="<%= subheading %>"><%= t('.bundles.manage_title') %></h3>
      <%= render "docs/list", items: t('.bundles.manage') %>
      <%= docs_screenshot "bundle-settings", alt: t('.bundles.settings_screenshot_alt'), caption: t('.bundles.settings_screenshot_caption') %>

      <h3 class="<%= subheading %>"><%= t('.bundles.states_title') %></h3>
      <%= render "docs/statuses", items: t('.bundles.states'), colors: { awaiting: :yellow, completed: :green, declined: :red, no_recipients: :gray } %>

      <h3 class="<%= subheading %>"><%= t('.bundles.recipient_states_title') %></h3>
      <%= render "docs/statuses", items: t('.bundles.recipient_states'), colors: { pending: :yellow, signed: :green, declined: :red, superseded: :gray, withdrawn: :amber } %>

      <h3 class="<%= subheading %>"><%= t('.bundles.signing_rules_title') %></h3>
      <%= render "docs/cards", items: t('.bundles.signing_rules') %>

      <div class="<%= callout %> border-gray-200 bg-white">
        <p class="text-sm font-semibold text-gray-900 mb-1"><%= t('.bundles.public_link_title') %></p>
        <p class="text-sm text-gray-600"><%= t('.bundles.public_link_description') %></p>
      </div>
      <div class="<%= callout %> border-gray-200 bg-white">
        <p class="text-sm font-semibold text-gray-900 mb-1"><%= t('.bundles.notifications_title') %></p>
        <p class="text-sm text-gray-600"><%= t('.bundles.notifications_description') %></p>
      </div>
    <% end %>

    <hr class="border-gray-200">

    <%# ─── PRIJATÉ NA PODPIS ──────────────────────────────────── %>
    <%= docs_section "received", title: t('.received.title'), icon: icons[:received], color: "bg-yellow-500" do %>
      <p class="text-gray-600 leading-7"><%= t('.received.intro') %></p>
      <%= docs_screenshot "received", alt: t('.received.screenshot_alt'), caption: t('.received.screenshot_caption') %>

      <h3 class="<%= subheading %>"><%= t('.received.states_title') %></h3>
      <%= render "docs/statuses", items: t('.received.states'), colors: { awaiting: :yellow, signed: :green, declined: :red, superseded: :gray } %>
      <p class="mt-4 text-sm text-gray-600"><%= t('.received.external_description') %></p>

      <h3 class="<%= subheading %>"><%= t('.received.sign_title') %></h3>
      <p class="text-sm text-gray-600"><%= t('.received.sign_description') %></p>
      <%= docs_screenshot "bundle-sign", alt: t('.received.sign_screenshot_alt'), caption: t('.received.sign_screenshot_caption') %>

      <div class="<%= callout %> border-yellow-100 bg-yellow-50">
        <p class="text-sm font-semibold text-yellow-900 mb-1"><%= t('.received.decline_title') %></p>
        <p class="text-sm text-yellow-800"><%= t('.received.decline_description') %></p>
      </div>
    <% end %>

    <hr class="border-gray-200">

    <%# ─── ARCHÍV PODPISOV ────────────────────────────────────── %>
    <%= docs_section "archive", title: t('.archive.title'), icon: icons[:archive], color: "bg-amber-600" do %>
      <p class="text-gray-600 leading-7"><%= t('.archive.intro') %></p>
      <%= docs_screenshot "validation-archive", alt: t('.archive.screenshot_alt'), caption: t('.archive.screenshot_caption') %>

      <h3 class="<%= subheading %>"><%= t('.archive.states_title') %></h3>
      <%= render "docs/statuses", items: t('.archive.states'), colors: { healthy: :green, expiring: :yellow, expired: :red, unknown: :gray } %>

      <h3 class="<%= subheading %>"><%= t('.archive.actions_title') %></h3>
      <%= render "docs/list", items: t('.archive.actions') %>
    <% end %>

    <hr class="border-gray-200">

    <%# ─── NASTAVENIA ─────────────────────────────────────────── %>
    <%= docs_section "account", title: t('.account.title'), icon: icons[:settings], color: "bg-gray-700" do %>
      <p class="text-gray-600 leading-7"><%= t('.account.intro') %></p>

      <h3 class="<%= subheading %>"><%= t('.account.account_title') %></h3>
      <%= render "docs/list", items: t('.account.items') %>
      <%= docs_screenshot "settings-account", alt: t('.account.account_screenshot_alt'), caption: t('.account.account_screenshot_caption') %>

      <h3 class="<%= subheading %>"><%= t('.account.organization_title') %></h3>
      <%= render "docs/list", items: t('.account.organization_items') %>
      <%= docs_screenshot "settings-organization", alt: t('.account.organization_screenshot_alt'), caption: t('.account.organization_screenshot_caption') %>
    <% end %>

    <hr class="border-gray-200">

    <% if FederationConfiguration.enabled? %>
      <%# ─── FEDERÁCIA ──────────────────────────────────────────── %>
      <%= docs_section "federation", title: t('.federation.title'), icon: icons[:federation], color: "bg-violet-700" do %>
        <p class="text-gray-600 leading-7 mb-6"><%= render_inline_code(t('.federation.intro')) %></p>

        <h3 class="text-base font-semibold text-gray-900 mb-3"><%= t('.federation.actors_title') %></h3>
        <div class="mb-6"><%= render "docs/cards", items: t('.federation.actors') %></div>

        <h3 class="text-base font-semibold text-gray-900 mb-3"><%= t('.federation.flow_title') %></h3>
        <div class="mb-6"><%= render "docs/steps", steps: t('.federation.flow'), color: "bg-violet-700" %></div>

        <h3 class="text-base font-semibold text-gray-900 mb-3"><%= t('.federation.requests_title') %></h3>
        <div class="mb-6"><%= render "docs/cards", items: t('.federation.requests') %></div>

        <h3 class="text-base font-semibold text-gray-900 mb-3"><%= t('.federation.security_title') %></h3>
        <ul role="list" class="list-disc pl-5 space-y-2 text-sm text-gray-600 mb-6">
          <% t('.federation.security_points').each_value do |point| %>
            <li><%= point %></li>
          <% end %>
        </ul>

        <div class="rounded-xl border border-violet-100 bg-violet-50 p-5">
          <p class="text-sm font-semibold text-violet-900 mb-1"><%= t('.federation.current_scope_title') %></p>
          <p class="text-sm text-violet-700"><%= render_inline_code(t('.federation.current_scope_description')) %></p>
        </div>
      <% end %>

      <hr class="border-gray-200">
    <% end %>

    <%# ─── API A SDK ──────────────────────────────────────────── %>
    <%= docs_section "integration", title: t('.integration.title'), icon: icons[:integration], color: "bg-slate-700" do %>
      <p class="text-gray-600 leading-7 mb-6"><%= render_inline_code(t('.integration.intro')) %></p>

      <ul role="list" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% t('.integration.links').each_value do |link| %>
          <li>
            <a href="<%= link[:url] %>" target="_blank" rel="noopener noreferrer" class="group block h-full rounded-xl border border-gray-200 bg-white p-5 hover:border-blue-300 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
              <span class="block text-sm font-semibold text-blue-700 underline underline-offset-2 group-hover:text-blue-900"><%= link[:label] %><%= docs_new_tab_hint %></span>
              <span class="mt-1 block text-sm text-gray-600"><%= link[:description] %></span>
            </a>
          </li>
        <% end %>
      </ul>
    <% end %>

  </div>
</div>

<% content_for :title, t('.header.title') %>
