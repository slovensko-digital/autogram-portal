<%# locals: (items:, colors:) %>
<dl class="space-y-3">
  <% items.each do |key, item| %>
    <div class="flex flex-col items-start gap-2 rounded-xl border border-gray-200 bg-white p-4 sm:flex-row sm:gap-3">
      <dt class="shrink-0 sm:mt-0.5"><%= docs_status_badge(item[:label], colors.fetch(key)) %></dt>
      <dd class="text-sm text-gray-600"><%= item[:description] %></dd>
    </div>
  <% end %>
</dl>
