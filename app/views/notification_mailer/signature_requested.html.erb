<%= render "mailer/badge", label: t(".badge"), tone: :blue %>
<%= render "mailer/heading", title: t(".title", author_name: @bundle.sender_display_name), message: t(".message") %>

<% if @bundle.note.present? %>
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#FEFCE8" style="background-color: #FEFCE8; border-radius: 10px; margin: 0 0 28px;">
    <tr>
      <td style="padding: 16px 18px;">
        <p style="margin: 0 0 6px; font-size: 13px; font-weight: 600; line-height: 18px; color: #854D0E;"><%= t(".note_from_sender_title") %></p>
        <%= simple_format(ERB::Util.html_escape(@bundle.note), { style: "margin: 0; font-size: 16px; line-height: 1.6; color: #1F2937;" }, wrapper_tag: "p") %>
      </td>
    </tr>
  </table>
<% end %>

<%= render "mailer/documents", title: t(".documents", count: @bundle.contracts.size), contracts: @bundle.contracts %>
<%= render "mailer/button", label: t(".view_bundle"), url: sign_bundle_url(@bundle, recipient: @user) %>

<p style="margin: 0 0 14px; font-size: 16px; font-weight: 700; line-height: 1.4; color: #111827;"><%= t(".how_it_works_title") %></p>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin: 0 0 28px;">
  <% 1.upto(3) do |step| %>
    <tr>
      <td width="26" valign="top" style="padding: 0 12px 14px 0;">
        <div style="width: 26px; height: 26px; border-radius: 13px; background-color: #EFF6FF; color: #1D4ED8; font-size: 14px; font-weight: 700; line-height: 26px; text-align: center;"><%= step %></div>
      </td>
      <td valign="top" style="padding: 2px 0 14px; font-size: 15px; line-height: 1.5; color: #374151;">
        <strong style="color: #111827;"><%= t(".step_#{step}_title") %></strong> <%= t(".step_#{step}_desc") %>
      </td>
    </tr>
  <% end %>
</table>
