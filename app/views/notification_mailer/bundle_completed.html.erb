<%= render "mailer/badge", label: t(".badge"), tone: :green %>
<%= render "mailer/heading", title: t(".title"), message: t(".message", bundle_name: @bundle.display_name) %>
<%= render "mailer/documents", title: t(".documents", count: @bundle.contracts.size), contracts: @bundle.contracts, checked: true %>
<%= render "mailer/button", label: t(".view_bundle"), url: url_for(@bundle) %>
