<%= render "mailer/badge", label: t(".badge"), tone: :green %>
<%= render "mailer/heading", title: t(".title"), message: t(".message") %>
<%= render "signature_details", contract: @contract, signer_name: @signature&.signerName || @signer&.display_name, signature: @signature %>
<%= render "mailer/button", label: t(".view_contract"), url: url_for(@contract) %>
