<%= render "mailer/badge", label: t(".badge"), tone: :gray %>
<%= render "mailer/heading", title: t(".title"), message: t(".message", author_name: @bundle.sender_display_name) %>
<%= render "mailer/documents", title: t(".documents"), contracts: @bundle.contracts %>
<%= render "mailer/button", label: t(".view_bundle"), url: sign_bundle_url(@bundle, recipient: @user.uuid), variant: :secondary %>
