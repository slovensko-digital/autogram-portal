<% content_for :title, t('header.links.home') %>

<div>
  <div class="mx-auto max-w-6xl px-6 pb-24 pt-10 lg:px-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900"><%= t('.title', name: (current_user.name.presence || current_user.email).split(/[\s@]/).first) %></h1>
      <p class="mt-1 text-sm text-gray-500"><%= current_tenant.pro? ? t('.subtitle_pro', name: current_tenant.name) : t('.subtitle') %></p>
    </div>
    <% if current_tenant.archivation_enabled? && @expiring_contract_validation_records_count.positive? %>
      <%= render 'shared/warning',
          title: t('.validation_warning.title'),
          content: t('.validation_warning.content', count: @expiring_contract_validation_records_count, date: @expiring_contract_validation_records.first.expires_at) %>
      <p class="-mt-1 mb-8 text-sm text-yellow-800">
        <%= link_to t('.validation_warning.action'), contract_validation_records_path(state: 'expiring'), class: 'underline hover:text-yellow-600 transition-colors font-semibold' %>
      </p>
    <% end %>
    <%= render current_tenant.pro? ? "dashboard/pro" : "dashboard/basic" %>
  </div>
</div>
