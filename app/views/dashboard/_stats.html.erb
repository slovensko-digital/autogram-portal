<div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5 mb-8">
  <%= link_to bundles_path, class: "bg-white rounded-lg border border-gray-200 p-5 hover:border-blue-300 transition-colors" do %>
    <div class="mb-3">
      <div class="h-9 w-9 rounded-lg bg-blue-50 flex items-center justify-center">
        <svg aria-hidden="true" class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
        </svg>
      </div>
    </div>
    <p class="text-2xl font-bold text-gray-900"><%= @bundles_count %></p>
    <p class="text-xs text-gray-500 mt-0.5"><%= t('dashboard.index.stats.my_bundles') %></p>
  <% end %>
  <%= link_to contracts_path, class: "bg-white rounded-lg border border-gray-200 p-5 hover:border-indigo-300 transition-colors" do %>
    <div class="mb-3">
      <div class="h-9 w-9 rounded-lg bg-indigo-50 flex items-center justify-center">
        <svg aria-hidden="true" class="h-5 w-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
      </div>
    </div>
    <p class="text-2xl font-bold text-gray-900"><%= @contracts_count %></p>
    <p class="text-xs text-gray-500 mt-0.5"><%= t('dashboard.index.stats.my_contracts') %></p>
  <% end %>
  <%= link_to received_bundles_path(state: 'awaiting'), class: "bg-white rounded-lg border border-gray-200 p-5 hover:border-yellow-300 transition-colors" do %>
    <div class="mb-3">
      <div class="h-9 w-9 rounded-lg bg-yellow-50 flex items-center justify-center">
        <svg aria-hidden="true" class="h-5 w-5 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
    </div>
    <p class="text-2xl font-bold text-gray-900"><%= @awaiting_my_signature_count %></p>
    <p class="text-xs text-gray-500 mt-0.5"><%= t('dashboard.index.stats.awaiting_my_signature') %></p>
  <% end %>
  <%= link_to bundles_path(state: 'awaiting'), class: "bg-white rounded-lg border border-gray-200 p-5 hover:border-green-300 transition-colors" do %>
    <div class="mb-3">
      <div class="h-9 w-9 rounded-lg bg-green-50 flex items-center justify-center">
        <svg aria-hidden="true" class="h-5 w-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
        </svg>
      </div>
    </div>
    <p class="text-2xl font-bold text-gray-900"><%= @sent_for_signing_count %></p>
    <p class="text-xs text-gray-500 mt-0.5"><%= t('dashboard.index.stats.sent_for_signing') %></p>
  <% end %>
  <%= link_to bundles_path(state: 'declined'), class: "bg-white rounded-lg border border-red-100 p-5 hover:border-red-300 transition-colors" do %>
    <div class="mb-3">
      <div class="h-9 w-9 rounded-lg bg-red-50 flex items-center justify-center">
        <svg aria-hidden="true" class="h-5 w-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
        </svg>
      </div>
    </div>
    <p class="text-2xl font-bold <%= @declined_bundles_count > 0 ? 'text-red-600' : 'text-gray-900' %>"><%= @declined_bundles_count %></p>
    <p class="text-xs text-gray-500 mt-0.5"><%= t('dashboard.index.stats.declined_bundles') %></p>
  <% end %>
</div>
