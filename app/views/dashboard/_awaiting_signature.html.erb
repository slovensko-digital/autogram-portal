<%# locals: (items:, count:, title:, subtitle:, heading_tag: :h2) %>

<section aria-labelledby="awaiting-signature-title" class="mb-8 overflow-hidden rounded-lg border border-gray-200 bg-white">
  <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-4">
    <div class="flex items-center gap-3">
      <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-yellow-50">
        <svg aria-hidden="true" class="h-5 w-5 text-yellow-700" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
        </svg>
      </div>
      <div>
        <%= content_tag heading_tag, id: "awaiting-signature-title", class: "text-lg font-semibold text-gray-900" do %>
          <%= title %>
          <% if count.positive? %>
            <span class="text-yellow-700">(<%= count %>)</span>
          <% end %>
        <% end %>
        <p class="mt-0.5 text-sm text-gray-500"><%= subtitle %></p>
      </div>
    </div>
    <%= link_to t("dashboard.index.awaiting.view_all"), received_bundles_path(state: "awaiting"), class: "text-sm font-medium text-blue-700 underline hover:text-blue-900" %>
  </div>

  <% if items.any? %>
    <ul role="list" class="divide-y divide-gray-100 border-t border-gray-100">
      <% items.each do |item| %>
        <li class="flex flex-wrap items-center gap-x-4 gap-y-2 px-5 py-3.5">
          <div class="min-w-0 flex-1 basis-64">
            <p class="break-words text-sm font-semibold text-gray-900"><%= item.name %></p>
            <p class="mt-0.5 text-xs text-gray-600">
              <%= t("dashboard.index.awaiting.from", sender: item.sender) %>
              · <%= t("dashboard.index.awaiting.received_on", date: item.received_at.strftime("%d.%m.%Y")) %>
              <% if item.documents_count %>
                · <%= item.documents_count %> <%= t("document", count: item.documents_count) %>
              <% end %>
            </p>
          </div>
          <%= link_to item.path, class: "inline-flex min-h-11 items-center justify-center rounded-lg border border-blue-500 bg-blue-50 px-4 text-sm font-semibold text-blue-700 transition-colors hover:bg-blue-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700" do %>
            <%= t("dashboard.index.awaiting.sign") %><span class="sr-only">: <%= item.name %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% if count > items.size %>
      <p class="border-t border-gray-100 px-5 py-3 text-sm text-gray-600">
        <%= link_to t("dashboard.index.awaiting.more", count: count - items.size), received_bundles_path(state: "awaiting"), class: "font-medium text-blue-700 underline hover:text-blue-900" %>
      </p>
    <% end %>
  <% else %>
    <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 border-t border-gray-100 px-5 py-3.5 text-sm">
      <svg aria-hidden="true" class="h-5 w-5 shrink-0 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
      <span class="font-semibold text-gray-700"><%= t("dashboard.index.awaiting.empty") %></span>
      <span class="text-gray-500"><%= t("dashboard.index.awaiting.empty_hint") %></span>
    </div>
  <% end %>
</section>
