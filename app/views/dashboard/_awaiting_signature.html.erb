<%# locals: (items:, count:) %>

<section aria-labelledby="awaiting-signature-title" class="mb-8">
  <%= render "dashboard/section_header",
        id: "awaiting-signature-title",
        title: count.positive? ? t("dashboard.index.awaiting.title_with_count", count: count) : t("dashboard.index.awaiting.title"),
        subtitle: t("dashboard.index.awaiting.subtitle"),
        path: (received_bundles_path(state: "awaiting") if count.positive?) %>

  <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
    <% if items.any? %>
      <ul role="list" class="divide-y divide-gray-100">
        <% items.each do |item| %>
          <li class="flex items-center gap-3 px-4 py-3.5 hover:bg-gray-50 transition-colors">
            <div class="h-9 w-9 rounded-lg <%= item.portal ? "bg-indigo-50" : "bg-blue-50" %> flex items-center justify-center shrink-0">
              <svg aria-hidden="true" class="h-5 w-5 <%= item.portal ? "text-indigo-600" : "text-blue-600" %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <%= link_to item.name, item.path, class: "text-sm font-semibold text-gray-900 hover:text-blue-600 transition-colors break-words" %>
              <div class="mt-0.5 flex items-center gap-3 text-xs text-gray-600 flex-wrap">
                <% if item.signatures %>
                  <span class="flex items-center gap-1">
                    <svg aria-hidden="true" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                    </svg>
                    <%= item.signatures %>
                  </span>
                <% end %>
                <% if item.portal %>
                  <span><%= t("bundles.received.from_portal", name: item.portal) %></span>
                <% end %>
                <span class="flex items-center gap-1">
                  <svg aria-hidden="true" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 9v7.5" />
                  </svg>
                  <%= item.received_at.strftime("%d.%m.%Y") %>
                </span>
              </div>
            </div>
            <%= link_to item.path, class: "underline text-sm font-medium text-blue-600 hover:text-blue-700 transition-colors shrink-0" do %>
              <%= t("actions.view") %><span class="sr-only">: <%= item.name %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 px-4 py-3.5 text-sm">
        <svg aria-hidden="true" class="h-5 w-5 shrink-0 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
        <span class="font-semibold text-gray-700"><%= t("dashboard.index.awaiting.empty") %></span>
        <span class="text-gray-500"><%= t("dashboard.index.awaiting.empty_hint") %></span>
      </div>
    <% end %>
  </div>
</section>
