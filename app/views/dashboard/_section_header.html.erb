<%# locals: (id:, title:, subtitle:, path: nil, heading_tag: :h2) %>

<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
  <div>
    <%= content_tag heading_tag, title, id: id, class: "text-lg font-semibold text-gray-900" %>
    <p class="text-sm text-gray-500"><%= subtitle %></p>
  </div>
  <% if path %>
    <%= link_to path, class: "inline-flex items-center gap-1.5 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors" do %>
      <%= t('dashboard.index.recent_bundles.view_all') %><span class="sr-only">: <%= title %></span>
      <svg aria-hidden="true" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
      </svg>
    <% end %>
  <% end %>
</div>
