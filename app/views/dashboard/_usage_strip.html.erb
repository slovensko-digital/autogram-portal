<%# locals: (tenant:, heading_tag: :h2) %>
<%# Limits the plan has, plus this month's counts (the PRO billing basis) even when unlimited. %>
<% entries = tenant.usage_summary.select { |entry| !entry.unlimited? || Tenant::Usage::MONTHLY_LIMIT_KINDS.key?(entry.limit) } %>

<% if entries.any? %>
  <section aria-labelledby="dashboard-usage-title" class="mt-10 mb-8">
    <%= render "dashboard/section_header",
          id: "dashboard-usage-title",
          title: t("tenants.usage.title"),
          subtitle: t("tenants.usage.subtitle"),
          path: edit_user_registration_path(anchor: "organization"),
          link_text: t("tenants.usage.details"),
          secondary: true,
          heading_tag: heading_tag %>
    <ul role="list" class="divide-y divide-gray-100 rounded-lg border border-gray-200 bg-white text-sm text-gray-600">
      <% entries.each do |entry| %>
        <li class="flex flex-wrap items-center gap-x-4 gap-y-1 px-4 py-3">
          <span class="flex-1"><%= t("tenants.usage.limits.#{entry.limit}") %></span>
          <% if entry.percentage %>
            <span aria-hidden="true" class="inline-block h-1.5 w-32 rounded-full bg-gray-200">
              <span class="block h-1.5 rounded-full <%= entry.reached? ? "bg-red-600" : "bg-blue-600" %>" style="width: <%= entry.percentage %>%"></span>
            </span>
          <% end %>
          <span class="min-w-16 text-right font-medium <%= entry.reached? ? "text-red-700" : "text-gray-900" %>">
            <% if entry.unlimited? %>
              <%= plan_usage_value(entry.limit, entry.used) %>
            <% else %>
              <span aria-hidden="true"><%= plan_usage_text(entry) %></span>
              <span class="sr-only"><%= plan_usage_text(entry, spoken: true) %></span>
            <% end %>
          </span>
          <% if entry.reached? %>
            <span class="basis-full text-right text-xs text-red-700"><%= t("tenants.usage.reached") %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
    <%= render "shared/retention_note", tenant: tenant, css_class: "mt-3" %>
  </section>
<% end %>
