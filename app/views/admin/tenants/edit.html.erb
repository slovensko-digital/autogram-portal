<% content_for :title, t('.title', name: @tenant.name) %>

<div class="mx-auto max-w-3xl space-y-6 px-4 py-8">
  <div>
    <h1 class="text-2xl font-semibold text-gray-900"><%= t('.title', name: @tenant.name) %></h1>
    <p class="mt-1 text-sm text-gray-600"><%= t('.subtitle') %></p>
  </div>

  <%= render "form" %>

  <%= render "tenants/usage", tenant: @tenant %>

  <%= render "usage", tenant: @tenant, month: @usage_month, usage_by_kind_and_source: @usage_by_kind_and_source %>

  <div class="rounded-lg border border-gray-200 bg-white">
    <div class="border-b border-gray-100 px-5 py-4">
      <h2 class="text-lg font-semibold text-gray-900"><%= t('.members') %></h2>
    </div>
    <ul role="list" class="divide-y divide-gray-100">
      <% @memberships.each do |membership| %>
        <li class="flex items-center justify-between px-5 py-3 text-sm">
          <span class="text-gray-900"><%= membership.user.display_name %></span>
          <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-700"><%= t("tenants.roles.#{membership.role}") %></span>
        </li>
      <% end %>
    </ul>
    <%= form_with url: add_member_admin_tenant_path(@tenant), method: :post, class: "flex flex-col gap-3 border-t border-gray-100 px-5 py-4 md:flex-row md:items-center" do |form| %>
      <%= form.email_field :email, required: true, placeholder: t('.add_member_placeholder'), class: "w-full md:max-w-sm rounded-md border border-gray-500 px-3 py-2 text-sm" %>
      <%= form.select :role, Membership.roles.keys.map { |role| [ t("tenants.roles.#{role}"), role ] }, { selected: "member" },
            class: "rounded-md border border-gray-500 px-3 py-2 text-sm" %>
      <%= form.submit t('.add_member'), class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
