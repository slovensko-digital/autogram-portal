<%= form_with model: [ :admin, @tenant ], class: "space-y-4 rounded-lg border border-gray-200 bg-white p-5" do |form| %>
  <% if @tenant.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-700">
      <p class="font-medium"><%= t('admin.tenants.form.error_title') %></p>
      <ul class="mt-2 list-disc pl-5">
        <% @tenant.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, t('admin.tenants.form.name'), class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :name, required: true, class: "w-full rounded-md border border-gray-500 px-3 py-2 text-sm" %>
  </div>

  <% if @tenant.new_record? %>
    <div>
      <%= label_tag :owner_email, t('admin.tenants.form.owner_email'), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= email_field_tag :owner_email, @owner_email, required: true, class: "w-full rounded-md border border-gray-500 px-3 py-2 text-sm" %>
      <p class="mt-1 text-xs text-gray-500"><%= t('admin.tenants.form.owner_email_help') %></p>
    </div>
  <% end %>

  <div>
    <%= form.label :plan, t('admin.tenants.form.plan'), class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.select :plan, Tenant.plans.keys.map { |plan| [ t("tenants.plans.#{plan}"), plan ] }, {},
          class: "w-full rounded-md border border-gray-500 px-3 py-2 text-sm" %>
  </div>

  <fieldset>
    <legend class="block text-sm font-medium text-gray-700 mb-2"><%= t('admin.tenants.form.features') %></legend>
    <%= hidden_field_tag "tenant[features][]", "" %>
    <div class="space-y-3">
      <% Tenant::AVAILABLE_FEATURES.each do |feature| %>
        <label class="flex items-start gap-3 rounded-lg border border-gray-200 px-4 py-3">
          <%= check_box_tag "tenant[features][]", feature, @tenant.feature_enabled?(feature), id: "tenant_features_#{feature}",
                class: "mt-0.5 h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
          <span>
            <span class="block text-sm font-semibold text-gray-900"><%= t("tenants.feature_labels.#{feature}") %></span>
            <span class="block text-sm text-gray-500"><%= t("tenants.feature_descriptions.#{feature}") %></span>
          </span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div class="flex items-center justify-end gap-3">
    <%= link_to t('admin.tenants.form.cancel'), admin_tenants_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
    <%= form.submit(@tenant.new_record? ? t('admin.tenants.form.create') : t('admin.tenants.form.save'),
          class: "inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 cursor-pointer") %>
  </div>
<% end %>
