<% content_for :title, t('.title') %>

<div class="mx-auto max-w-5xl space-y-6 px-4 py-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900"><%= t('.title') %></h1>
      <p class="mt-1 text-sm text-gray-600"><%= t('.subtitle') %></p>
    </div>
    <div class="flex flex-col gap-2 sm:flex-row">
      <%= form_with url: admin_tenants_path, method: :get, class: "flex gap-2" do |form| %>
        <%= form.search_field :q, value: params[:q], placeholder: t('.search_placeholder'), class: "w-full sm:w-64 rounded-md border border-gray-500 px-3 py-2 text-sm" %>
        <%= form.submit t('.search'), name: nil, class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 cursor-pointer" %>
      <% end %>
      <%= link_to t('.new'), new_admin_tenant_path, class: "inline-flex items-center justify-center rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>
    </div>
  </div>

  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left font-medium text-gray-700"><%= t('.id') %></th>
          <th class="px-4 py-3 text-left font-medium text-gray-700"><%= t('.name') %></th>
          <th class="px-4 py-3 text-left font-medium text-gray-700"><%= t('.plan') %></th>
          <th class="px-4 py-3 text-left font-medium text-gray-700"><%= t('.owners') %></th>
          <th class="px-4 py-3 text-left font-medium text-gray-700"><%= t('.members') %></th>
          <th class="px-4 py-3 text-left font-medium text-gray-700"><%= t('.features') %></th>
          <th class="px-4 py-3 text-right font-medium text-gray-700"><%= t('.actions') %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @tenants.each do |tenant| %>
          <tr>
            <td class="px-4 py-3 text-gray-500"><%= tenant.id %></td>
            <td class="px-4 py-3 text-gray-900"><%= tenant.name %></td>
            <td class="px-4 py-3 text-gray-600"><%= t("tenants.plans.#{tenant.plan}") %></td>
            <td class="px-4 py-3 text-gray-600"><%= tenant.owners.map(&:email).join(", ") %></td>
            <td class="px-4 py-3 text-gray-600"><%= tenant.members_count %></td>
            <td class="px-4 py-3 text-gray-600"><%= tenant.features.map { |feature| t("tenants.feature_labels.#{feature}") }.join(", ") %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to t('.edit'), edit_admin_tenant_path(tenant), class: "text-blue-600 hover:text-blue-800" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
