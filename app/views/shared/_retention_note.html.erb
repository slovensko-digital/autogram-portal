<%# locals: (tenant:, css_class: "mt-1") %>
<%# How long the plan of the tenant keeps documents; nothing for plans that keep them. %>
<% if (retention = tenant&.limits&.retention) %>
  <p class="<%= css_class %> flex items-start gap-1.5 text-sm text-gray-600">
    <svg aria-hidden="true" class="mt-0.5 h-4 w-4 shrink-0 text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <span><%= t("retention.note", plan: t("tenants.plans.#{tenant.plan}"), count: retention.in_days.to_i) %></span>
  </p>
<% end %>
