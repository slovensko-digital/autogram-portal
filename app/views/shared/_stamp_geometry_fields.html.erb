<%# locals: (name_prefix:, x:, y:, width:, height:, max_width: VisualStamp::MAX_WIDTH, max_height: VisualStamp::MAX_HEIGHT, locked: false, invalid: []) %>

<%#
  Numeric alternative to dragging the stamp / signature field in the PDF preview (WCAG 2.1.1, 2.5.7).
  The inputs are the form fields submitted to the server; visual_stamp_controller keeps them in sync with the preview.
%>
<% hint_id = "#{name_prefix.parameterize(separator: '_')}_geometry_hint" %>
<fieldset class="mt-4 rounded-md bg-white p-3">
  <legend class="float-left w-full text-sm font-medium text-gray-900"><%= t('shared.stamp_geometry.legend') %></legend>
  <p id="<%= hint_id %>" class="clear-both pt-1 text-xs text-gray-600">
    <%= locked ? t('shared.stamp_geometry.locked_hint') : t('shared.stamp_geometry.hint') %>
  </p>
  <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <% { x: [ x, nil ], y: [ y, nil ], width: [ width, max_width ], height: [ height, max_height ] }.each do |attribute, (value, max)| %>
      <% field_name = "#{name_prefix}[#{attribute}]" %>
      <% field_invalid = invalid.include?(attribute) %>
      <div>
        <%= label_tag field_name, t("shared.stamp_geometry.#{attribute}"), class: "block text-xs font-medium text-gray-700" %>
        <%= number_field_tag field_name, value,
              min: (attribute.in?(%i[x y]) ? 0 : 1),
              max: max,
              step: "any",
              readonly: locked,
              "aria-describedby": [ hint_id, ("visual_stamp_errors" if field_invalid) ].compact.join(" "),
              "aria-invalid": (field_invalid ? "true" : nil),
              autofocus: (field_invalid && invalid.first == attribute),
              class: "mt-1 w-full rounded-md border border-gray-500 px-2 py-1.5 text-sm read-only:bg-gray-50 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500",
              data: { visual_stamp_target: "#{attribute}Field", action: "change->visual-stamp#geometryFieldChanged" } %>
      </div>
    <% end %>
  </div>
  <p role="status" class="sr-only" data-visual-stamp-target="status"
     data-template="<%= t('shared.stamp_geometry.status', x: '%{x}', y: '%{y}', width: '%{width}', height: '%{height}') %>"></p>
</fieldset>
