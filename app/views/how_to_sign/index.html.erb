<%# Návod Ako podpisovať. Texty sú v config/locales (how_to_sign.index). %>
<% content_for :title, t('header.links.how_to_sign') %>
<% video_url = "https://static-ssd.s3.eu-central-1.amazonaws.com/agp.mp4" %>
<% link_class = "font-semibold text-blue-700 underline underline-offset-4 hover:text-blue-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" %>

<%# Úvod a video %>
<div class="border-b border-gray-200 bg-white px-6 py-12 lg:px-8 lg:py-16">
  <div class="mx-auto max-w-6xl">
    <p class="flex items-center gap-2 text-sm font-semibold text-blue-700">
      <svg aria-hidden="true" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7.864 4.243A7.5 7.5 0 0 1 19.5 10.5c0 2.92-.556 5.709-1.568 8.268M5.742 6.364A7 7 0 0 0 4.5 10.5a7.064 7.064 0 0 1-1.15 3.993m1.989 3.559A11.209 11.209 0 0 0 8.25 10.5a3.75 3.75 0 1 1 7.5 0c0 .527-.021 1.049-.064 1.565M12 10.5a14.94 14.94 0 0 1-3.6 9.75m6.633-4.596a18.666 18.666 0 0 1-2.485 5.33" />
      </svg>
      <%= t('.header.eyebrow') %>
    </p>
    <h1 class="mt-3 max-w-4xl text-4xl font-bold tracking-tight text-balance text-gray-900 lg:text-5xl"><%= t('.header.title') %></h1>
    <p class="mt-4 max-w-2xl text-lg leading-8 text-gray-600"><%= t('.header.subtitle') %></p>

    <figure class="mt-10 max-w-4xl">
      <video controls playsinline preload="metadata" aria-label="<%= t('.video.title') %>" aria-describedby="how-to-sign-video-caption"
             class="aspect-video w-full rounded-xl border border-gray-200 bg-gray-900">
        <source src="<%= video_url %>" type="video/mp4">
        <p class="p-5 text-white"><%= t('.video.fallback_html', link: link_to(t('.video.download_link'), video_url, class: "underline")) %></p>
      </video>
      <figcaption id="how-to-sign-video-caption" class="mt-3 text-sm text-gray-600">
        <%= t('.video.caption_html', link: link_to(t('.video.text_guide_link'), "#guide", data: { turbo: false }, class: link_class)) %>
      </figcaption>
    </figure>

    <div class="mt-10 flex max-w-4xl items-start gap-4 rounded-xl border border-blue-100 bg-blue-50 p-5">
      <span aria-hidden="true" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white text-blue-700">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
        </svg>
      </span>
      <p class="text-base leading-7 text-blue-900"><%= t('.anonymous_html') %></p>
    </div>
  </div>
</div>

<%# Návod krok za krokom. Odkaz pod videom ide bez Turba, aby prehliadač presunul fokus na túto sekciu. %>
<section id="guide" tabindex="-1" aria-labelledby="guide-heading"
         class="scroll-mt-8 border-b border-gray-200 bg-gray-50 px-6 py-16 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600 lg:px-8 lg:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-3xl">
      <p class="text-base font-semibold leading-7 text-blue-600"><%= t('.guide.subtitle') %></p>
      <h2 id="guide-heading" class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"><%= t('.guide.title') %></h2>
      <p class="mt-5 text-lg leading-8 text-gray-600"><%= t('.guide.intro') %></p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-5 lg:grid-cols-2">
      <% {
           send: [ "M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" ],
           sign: [ "m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" ],
           received: [ "M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859m-19.5.338V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H6.911a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661Z" ],
           validate: [ "m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z", "M7.5 10.5l2 2 3.5-4" ]
         }.each do |key, paths| %>
        <% optional = ->(part) { t(".guide.#{key}.#{part}") if I18n.exists?("how_to_sign.index.guide.#{key}.#{part}") } %>
        <% intro, note = optional.(:intro), optional.(:note) %>
        <% steps, items = Array(optional.(:steps_html)), Array(optional.(:items_html)) %>
        <div class="rounded-xl border border-gray-200 bg-white p-7">
          <div class="flex items-center gap-4">
            <span aria-hidden="true" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-700">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <% paths.each do |d| %><path stroke-linecap="round" stroke-linejoin="round" d="<%= d %>" /><% end %>
              </svg>
            </span>
            <h3 class="text-xl font-semibold text-gray-900"><%= t(".guide.#{key}.title") %></h3>
          </div>

          <% if intro %>
            <p class="mt-5 text-base leading-7 text-gray-600"><%= intro %></p>
          <% end %>

          <% if steps.any? %>
            <ol role="list" class="mt-6 space-y-4">
              <% steps.each.with_index(1) do |step, number| %>
                <li class="flex items-start gap-3">
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border-2 border-blue-600 bg-white text-sm font-bold text-blue-700"><%= number %><span class="sr-only">.</span></span>
                  <span class="text-base leading-7 text-gray-700"><%= step %></span>
                </li>
              <% end %>
            </ol>
          <% end %>

          <% if items.any? %>
            <ul role="list" class="mt-4 space-y-3">
              <% items.each do |item| %>
                <li class="flex items-start gap-3">
                  <svg aria-hidden="true" class="mt-1 h-5 w-5 shrink-0 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                  </svg>
                  <span class="text-base leading-7 text-gray-700"><%= item %></span>
                </li>
              <% end %>
            </ul>
          <% end %>

          <% if note %>
            <p class="mt-6 border-t border-gray-100 pt-5 text-base leading-7 text-gray-600"><%= note %></p>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="mt-5 grid grid-cols-1 gap-5 lg:grid-cols-2">
      <div class="rounded-xl border border-gray-200 bg-white p-7">
        <h3 class="text-xl font-semibold text-gray-900"><%= t('.apps.title') %></h3>
        <p class="mt-3 text-base leading-7 text-gray-600"><%= t('.apps.description') %></p>
        <ul role="list" class="mt-5 flex flex-wrap gap-2">
          <% t('.apps.items').each do |app| %>
            <li class="rounded-full bg-gray-100 px-3 py-1 text-sm font-semibold text-gray-800"><%= app %></li>
          <% end %>
        </ul>
      </div>

      <div class="rounded-xl border border-gray-200 bg-white p-7">
        <h3 class="text-xl font-semibold text-gray-900"><%= t('.download.title') %></h3>
        <p class="mt-3 text-base leading-7 text-gray-600"><%= t('.download.description') %></p>
        <p class="mt-5 flex items-start gap-3 rounded-lg border border-amber-200 bg-amber-50 p-4 text-base leading-7 text-amber-900">
          <svg aria-hidden="true" class="mt-1 h-5 w-5 shrink-0 text-amber-700" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          <span><%= t('.download.tip_html') %></span>
        </p>
      </div>
    </div>
  </div>
</section>

<%# Výzva na akciu %>
<section aria-labelledby="how-to-sign-cta-heading" class="bg-white px-6 py-16 lg:px-8 lg:py-20">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6">
    <div class="max-w-2xl">
      <h2 id="how-to-sign-cta-heading" class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl"><%= t('.cta.title') %></h2>
      <p class="mt-2 text-lg leading-8 text-gray-600">
        <%= t('.cta.description_html', docs: link_to(t('.cta.docs_link'), docs_path, class: link_class)) %>
      </p>
    </div>
    <%= link_to new_contract_path, class: "inline-flex min-h-12 items-center gap-2 rounded-md bg-blue-600 px-5 text-base font-semibold text-white hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" do %>
      <%= t('.cta.upload') %>
      <svg aria-hidden="true" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
      </svg>
    <% end %>
  </div>
</section>
