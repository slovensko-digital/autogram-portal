<%# Návod Ako podpisovať. Texty sú v config/locales (how_to_sign.index). %>
<% content_for :title, t('header.links.how_to_sign') %>
<%# Stránka končí bielou sekciou cez celú šírku, pätička na ňu nadväzuje bez medzery. %>
<% content_for :footer_flush, "true" %>
<% video_host = "https://static-ssd.s3.eu-central-1.amazonaws.com" %>
<% video_url = "#{video_host}/agp.mp4" %>
<% link_class = "font-semibold text-blue-700 underline underline-offset-4 hover:text-blue-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" %>
<%# Postupy krok za krokom: kľúč scenára => kroky (kľúč textu => ikona). Posledný krok je zelený. %>
<% scenarios = {
     send: { upload: :upload, action: :action, signature_type: :signature_type, recipients: :recipients, email: :email },
     sign: { upload: :upload, method: :id_card, app: :desktop, finish: :check }
   } %>

<%# Úvod: video a vedľa neho obsah návodu. Odkazy na kotvy idú bez Turba, aby prehliadač presunul fokus na cieľ. %>
<% toc_link_class = "-ml-px flex min-h-10 items-center gap-2 border-l-2 py-1.5 pl-4 text-base underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" %>
<div class="border-b border-gray-200 bg-white px-6 pt-12 pb-16 lg:px-8 lg:pt-16 lg:pb-20">
  <div class="mx-auto max-w-6xl">
    <p class="text-sm font-semibold text-blue-700"><%= t('.header.eyebrow') %></p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-balance text-gray-900 lg:text-5xl">
      <%= t('.header.title') %> <span class="text-blue-600"><%= t('.header.title_highlight') %></span>
    </h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-gray-600"><%= t('.header.subtitle') %></p>

    <div class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-3 lg:gap-8">
      <figure id="video" tabindex="-1" class="scroll-mt-8 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600 lg:col-span-2">
        <%# crossorigin: titulky sú na S3, prehliadač ich načíta len cez CORS (bucket musí posielať Access-Control-Allow-Origin). %>
        <video controls playsinline preload="metadata" crossorigin="anonymous" aria-label="<%= t('.video.title') %>" aria-describedby="how-to-sign-video-caption"
               class="aspect-video w-full rounded-xl border border-gray-200 bg-gray-900">
          <source src="<%= video_url %>" type="video/mp4">
          <%# Video je po slovensky: slovenské titulky sú prepis, anglické preklad a v anglickej verzii sa zapnú samy. %>
          <track kind="captions" src="<%= video_host %>/agp.sk.vtt" srclang="sk" label="<%= t('language_switcher.languages.sk') %>">
          <track kind="subtitles" src="<%= video_host %>/agp.en.vtt" srclang="en" label="<%= t('language_switcher.languages.en') %>" <%= "default" if I18n.locale == :en %>>
          <p class="p-5 text-white"><%= t('.video.fallback_html', link: link_to(t('.video.download_link'), video_url, class: "underline")) %></p>
        </video>
        <figcaption id="how-to-sign-video-caption" class="mt-3 text-sm leading-6 text-gray-600">
          <%= t('.video.caption_html', link: link_to(t('.video.text_guide_link'), "#guide", data: { turbo: false }, class: link_class)) %>
        </figcaption>
      </figure>

      <nav aria-labelledby="how-to-sign-contents" class="flex flex-col">
        <h2 id="how-to-sign-contents" class="text-base font-semibold text-gray-900"><%= t('.contents.title') %></h2>
        <ul role="list" class="mt-3 border-l border-gray-200">
          <li>
            <%= link_to "#video", data: { turbo: false }, aria: { current: true }, class: "#{toc_link_class} border-blue-700 font-semibold text-blue-700 hover:underline" do %>
              <%= how_to_sign_icon(:play, "h-4 w-4 shrink-0", stroke_width: 2) %>
              <%= t('.contents.video') %>
            <% end %>
          </li>
          <% %i[send sign eid received validate apps].each do |anchor| %>
            <li>
              <%= link_to t(".contents.#{anchor}"), "##{anchor}", data: { turbo: false },
                    class: "#{toc_link_class} border-transparent text-gray-700 hover:border-gray-400 hover:text-blue-700 hover:underline" %>
            </li>
          <% end %>
        </ul>
        <p class="mt-6 flex items-start gap-2.5 text-sm leading-6 text-gray-600 lg:mt-auto lg:pt-6">
          <%= how_to_sign_icon(:key, "mt-0.5 h-5 w-5 shrink-0 text-blue-700", stroke_width: 1.75) %>
          <span><%= t('.anonymous_html') %></span>
        </p>
      </nav>
    </div>
  </div>
</div>

<%# Návod krok za krokom %>
<section id="guide" tabindex="-1" aria-labelledby="guide-heading"
         class="scroll-mt-8 border-b border-gray-200 bg-gray-50 px-6 py-16 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600 lg:px-8 lg:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-3xl">
      <p class="text-base font-semibold leading-7 text-blue-600"><%= t('.guide.subtitle') %></p>
      <h2 id="guide-heading" class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"><%= t('.guide.title') %></h2>
      <p class="mt-5 text-lg leading-8 text-gray-600"><%= t('.guide.intro') %></p>
    </div>

    <% scenarios.each_with_index do |(scenario, steps), index| %>
      <% if index.positive? %>
        <hr class="mt-16 border-gray-200 lg:mt-20">
      <% end %>
      <div id="<%= scenario %>" tabindex="-1" aria-labelledby="<%= scenario %>-heading" role="group"
           class="mt-16 scroll-mt-8 focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-blue-600 lg:mt-20">
        <div class="flex items-center gap-4">
          <span aria-hidden="true" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-700">
            <%= how_to_sign_icon(scenario, "h-6 w-6") %>
          </span>
          <h3 id="<%= scenario %>-heading" class="text-2xl font-bold text-gray-900"><%= t(".guide.#{scenario}.title") %></h3>
        </div>
        <ol role="list" class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-2 <%= steps.size == 5 ? 'lg:grid-cols-5' : 'lg:grid-cols-4' %> lg:gap-5">
          <% steps.each_with_index do |(step, step_icon), step_index| %>
            <% last = step_index == steps.size - 1 %>
            <li>
              <div class="flex items-center gap-3">
                <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full <%= last ? 'bg-green-700 text-white' : 'border-2 border-blue-600 bg-white text-blue-700' %>">
                  <%= how_to_sign_icon(step_icon, "h-5 w-5", stroke_width: last ? 2 : 1.75) %>
                </span>
                <% unless last %>
                  <span aria-hidden="true" class="hidden flex-1 border-t-2 border-dashed border-gray-300 lg:block"></span>
                <% end %>
              </div>
              <h4 class="mt-4 text-lg font-semibold text-gray-900"><%= t(".guide.#{scenario}.steps.#{step}.title") %></h4>
              <p class="mt-1.5 text-base leading-7 text-gray-600"><%= t(".guide.#{scenario}.steps.#{step}.text_html") %></p>
            </li>
          <% end %>
        </ol>
        <% if scenario == :sign %>
          <p class="mt-8 flex items-start gap-2.5 text-base leading-7 text-gray-700">
            <%= how_to_sign_icon(:id_card, "mt-0.5 h-6 w-6 shrink-0 text-blue-700", stroke_width: 1.75) %>
            <span><%= t('.guide.sign.eid_hint_html', link: link_to(t('.guide.sign.eid_hint_link'), "#eid", data: { turbo: false }, class: link_class)) %></span>
          </p>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<%# Podpisové certifikáty na občianskom preukaze %>
<% eid_needs = { computer: :desktop, reader: :credit_card, id_card: :id_card, bok: :lock, eid_client: :download } %>
<% eid_steps = { start: :play, issue: :signature_type, pin: :key, confirm: :sign, done: :check } %>
<section id="eid" tabindex="-1" aria-labelledby="eid-heading"
         class="scroll-mt-8 border-b border-gray-200 bg-white px-6 py-16 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600 lg:px-8 lg:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-3xl">
      <p class="text-base font-semibold leading-7 text-blue-600"><%= t('.eid.subtitle') %></p>
      <h2 id="eid-heading" class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"><%= t('.eid.title') %></h2>
      <p class="mt-5 text-lg leading-8 text-gray-600"><%= t('.eid.intro') %></p>
    </div>

    <div class="mt-12 grid grid-cols-1 items-start gap-12 lg:grid-cols-5 lg:gap-16">
      <div class="rounded-lg border border-gray-200 bg-gray-50 p-6 sm:p-7 lg:col-span-2">
        <h3 class="text-xl font-bold text-gray-900"><%= t('.eid.needs_title') %></h3>
        <ul role="list" class="mt-5 space-y-5">
          <% eid_needs.each do |need, need_icon| %>
            <li class="flex items-start gap-3.5">
              <span aria-hidden="true" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-gray-200 bg-white text-blue-700">
                <%= how_to_sign_icon(need_icon, "h-5 w-5", stroke_width: 1.75) %>
              </span>
              <p class="text-base leading-6 text-gray-600">
                <span class="block font-semibold text-gray-900"><%= t(".eid.needs.#{need}.title") %></span>
                <span class="mt-0.5 block"><%= t(".eid.needs.#{need}.description_html") %></span>
              </p>
            </li>
          <% end %>
        </ul>
        <p class="mt-6 border-t border-gray-200 pt-5 text-base leading-7 text-gray-600">
          <%= t('.eid.have_certificates_html', link: link_to(t('.eid.have_certificates_link'), "#sign", data: { turbo: false }, class: link_class)) %>
        </p>
      </div>

      <div class="lg:col-span-3">
        <h3 class="text-xl font-bold text-gray-900"><%= t('.eid.steps_title') %></h3>
        <ol role="list" class="mt-6">
          <% eid_steps.each_with_index do |(step, step_icon), step_index| %>
            <% last = step_index == eid_steps.size - 1 %>
            <li class="flex gap-5">
              <div aria-hidden="true" class="flex flex-col items-center">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full <%= last ? 'bg-green-700 text-white' : 'border-2 border-blue-600 bg-white text-blue-700' %>">
                  <%= how_to_sign_icon(step_icon, "h-5 w-5", stroke_width: last ? 2 : 1.75) %>
                </span>
                <% unless last %>
                  <span class="min-h-6 flex-1 border-l-2 border-dashed border-gray-300"></span>
                <% end %>
              </div>
              <div class="<%= last ? 'pt-2' : 'pt-2 pb-7' %>">
                <h4 class="text-lg font-semibold text-gray-900"><%= t(".eid.steps.#{step}.title") %></h4>
                <p class="mt-1.5 text-base leading-7 text-gray-600"><%= t(".eid.steps.#{step}.text_html") %></p>
              </div>
            </li>
          <% end %>
        </ol>
        <p class="mt-8">
          <%= link_to "https://navody.digital/zivotne-situacie/aktivacia-eid/krok/certifikaty", target: "_blank", rel: "noopener",
                class: "inline-flex min-h-11 items-center gap-2 text-lg #{link_class}" do %>
            <span><%= t('.eid.more_link') %><span class="sr-only"> <%= t('.opens_in_new_tab') %></span></span>
            <%= how_to_sign_icon(:external, "h-5 w-5 shrink-0", stroke_width: 2) %>
          <% end %>
        </p>
      </div>
    </div>
  </div>
</section>

<%# Prijatý dokument a overenie podpisov %>
<section aria-label="<%= t('.other_tasks_label') %>" class="border-b border-gray-200 bg-gray-50 px-6 py-16 lg:px-8 lg:py-24">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-14 lg:grid-cols-2 lg:gap-20">
    <div id="received" tabindex="-1" class="scroll-mt-8 focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-blue-600">
      <span aria-hidden="true" class="flex h-12 w-12 items-center justify-center rounded-lg bg-blue-100 text-blue-700">
        <%= how_to_sign_icon(:received, "h-6 w-6") %>
      </span>
      <h3 class="mt-5 text-2xl font-bold text-gray-900"><%= t('.guide.received.title') %></h3>
      <p class="mt-3 text-lg leading-8 text-gray-600"><%= t('.guide.received.intro') %></p>
      <ul role="list" class="mt-5 space-y-3">
        <% { user: :signed_in_html, email: :email_html }.each do |item_icon, item| %>
          <li class="flex items-start gap-3 text-lg leading-8 text-gray-700">
            <%= how_to_sign_icon(item_icon, "mt-1 h-6 w-6 shrink-0 text-blue-700", stroke_width: 1.75) %>
            <span><%= t(".guide.received.items.#{item}") %></span>
          </li>
        <% end %>
      </ul>
      <p class="mt-5 text-lg leading-8 text-gray-600"><%= t('.guide.received.note') %></p>
    </div>

    <div id="validate" tabindex="-1" class="scroll-mt-8 focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-blue-600">
      <span aria-hidden="true" class="flex h-12 w-12 items-center justify-center rounded-lg bg-blue-100 text-blue-700">
        <%= how_to_sign_icon(:validate, "h-6 w-6") %>
      </span>
      <h3 class="mt-5 text-2xl font-bold text-gray-900"><%= t('.guide.validate.title') %></h3>
      <p class="mt-3 text-lg leading-8 text-gray-600"><%= t('.guide.validate.intro') %></p>
      <p class="mt-6">
        <%= link_to new_contract_path, class: "inline-flex min-h-11 items-center gap-2 text-lg #{link_class}" do %>
          <%= t('.guide.validate.link') %>
          <%= how_to_sign_icon(:arrow_right, "h-5 w-5", stroke_width: 2) %>
        <% end %>
      </p>
    </div>
  </div>
</section>

<%# Podpisové aplikácie a hotový dokument %>
<section id="apps" tabindex="-1" aria-labelledby="apps-heading" class="scroll-mt-8 border-b border-gray-200 bg-white px-6 py-16 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600 lg:px-8 lg:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-3xl">
      <p class="text-base font-semibold leading-7 text-blue-600"><%= t('.apps.subtitle') %></p>
      <h2 id="apps-heading" class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"><%= t('.apps.title') %></h2>
      <p class="mt-5 text-lg leading-8 text-gray-600"><%= t('.apps.description') %></p>
    </div>
    <ul role="list" class="mt-8 flex flex-wrap items-center gap-3">
      <% { autogram: :desktop, autogram_mobile: :mobile, eidentita: :id_card, podpisuj: :pen }.each do |app, app_icon| %>
        <li class="flex min-h-13 items-center gap-2.5 rounded-lg border border-gray-200 bg-gray-50 px-5 text-lg font-semibold text-gray-900">
          <%= how_to_sign_icon(app_icon, "h-5 w-5 text-blue-700", stroke_width: 1.75) %>
          <%= t(".apps.items.#{app}") %>
        </li>
      <% end %>
      <li class="px-1 text-base text-gray-600"><%= t('.apps.more') %></li>
    </ul>

    <div class="mt-14 grid grid-cols-1 gap-8 border-t border-gray-200 pt-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <h3 class="text-2xl font-bold text-gray-900"><%= t('.download.title') %></h3>
        <p class="mt-3 text-lg leading-8 text-gray-600"><%= t('.download.description') %></p>
      </div>
      <div class="flex items-start gap-5">
        <span aria-hidden="true" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gray-200 text-gray-700">
          <%= how_to_sign_icon(:clock, "h-6 w-6", stroke_width: 1.75) %>
        </span>
        <p class="text-base leading-7 text-gray-600">
          <span class="block font-semibold text-gray-700"><%= t('.download.anonymous_label') %></span>
          <span class="mt-0.5 block text-3xl font-bold text-gray-900"><%= t('.download.anonymous_value') %></span>
          <span class="mt-1.5 block"><%= t('.download.anonymous_description') %></span>
        </p>
      </div>
    </div>
  </div>
</section>

<%# Výzva na akciu %>
<section aria-labelledby="how-to-sign-cta-heading" class="bg-white px-6 py-16 lg:px-8 lg:py-20">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 rounded-2xl bg-blue-700 px-6 py-10 sm:px-10 lg:px-12 lg:py-12">
    <div class="max-w-2xl">
      <h2 id="how-to-sign-cta-heading" class="text-2xl font-bold tracking-tight text-white sm:text-3xl"><%= t('.cta.title') %></h2>
      <p class="mt-2 text-lg leading-8 text-blue-100">
        <%= t('.cta.description_html', docs: link_to(t('.cta.docs_link'), docs_path, class: "font-semibold text-white underline underline-offset-4 hover:text-blue-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white")) %>
      </p>
    </div>
    <%= link_to new_contract_path, class: "btn bg-white text-blue-700 hover:bg-blue-50 focus-visible:outline-white" do %>
      <%= t('.cta.upload') %>
      <%= how_to_sign_icon(:arrow_right, "h-5 w-5", stroke_width: 2) %>
    <% end %>
  </div>
</section>
