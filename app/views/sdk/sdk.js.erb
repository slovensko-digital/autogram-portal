(function() {
    const strings = <%= raw(I18n.available_locales.index_with { |locale| I18n.t("sdk", locale: locale) }.to_json) %>;
    const localized = (locale) => {
        const pageLocale = (document.documentElement.lang || '').slice(0, 2);
        return strings[locale] || strings[pageLocale] || strings['<%= I18n.default_locale %>'];
    };

    window.agp = {
        // Initialize contract iframe with options
        initContractIframe: function (sessionId, options = {}) {
            return this._initIframe('contracts', sessionId, options);
        },

        // Initialize bundle iframe with options
        initBundleIframe: function (sessionId, options = {}) {
            return this._initIframe('bundles', sessionId, options);
        },

        // Backward compatibility - alias to initContractIframe
        initIframe: function (sessionId, options = {}) {
            return this.initContractIframe(sessionId, options);
        },

        // Internal method to initialize iframe with options
        _initIframe: function (resourceType, sessionId, options = {}) {
            const config = {
                mode: options.mode || 'iframe', // 'iframe' or 'popup'
                parentElement: options.parentElement || null,
                previewLevel: options.previewLevel || false,
                width: options.width || '100%',
                height: options.height || '800px',
                border: options.border || null,
                baseUrl: options.baseUrl || "<%= root_url.chomp('/') %>",
                popupWidth: options.popupWidth || 800,
                popupHeight: options.popupHeight || 600,
                popupTitle: options.popupTitle || localized(options.locale).popup_title,
                title: options.title || localized(options.locale).iframe_title,
                closeLabel: localized(options.locale).close_label,
                onMessage: options.onMessage || null,
                onClose: options.onClose || null,
                recipientId: options.recipientId || null,
                locale: options.locale || null,
                resourceType: resourceType
            };

            if (config.mode === 'popup') {
                return this._createPopup(sessionId, config);
            } else {
                return this._createIframe(sessionId, config);
            }
        },

        // Create iframe mode
        _createIframe: function (sessionId, config) {
            const iframe = document.createElement('iframe');
            const iframeParam = config.previewLevel || 'true';
            const params = new URLSearchParams({ iframe: iframeParam });
            if (config.recipientId) params.set('recipient', config.recipientId);
            if (config.locale) params.set('locale', config.locale);
            iframe.src = `${config.baseUrl}/${config.resourceType}/${sessionId}/sign?${params}`;
            iframe.style.width = config.width;
            iframe.style.height = config.height;
            iframe.style.border = config.border;
            iframe.setAttribute('data-agp-session', sessionId);
            iframe.setAttribute('allow', 'loopback-network');
            iframe.setAttribute('title', config.title);

            // Set up message listener
            this._setupMessageListener(config, iframe);

            // Append to specified parent or body
            const targetElement = config.parentElement || document.body;
            if (typeof targetElement === 'string') {
                const element = document.querySelector(targetElement);
                if (element) {
                    element.appendChild(iframe);
                } else {
                    console.error('AGP: Parent element not found:', targetElement);
                    document.body.appendChild(iframe);
                }
            } else {
                targetElement.appendChild(iframe);
            }

            return {
                iframe: iframe,
                destroy: () => {
                    this._removeMessageListener(iframe);
                    if (iframe.parentNode) {
                        iframe.parentNode.removeChild(iframe);
                    }
                }
            };
        },

        // Create popup mode
        _createPopup: function (sessionId, config) {
            const popup = document.createElement('div');
            popup.style.cssText = `
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.7);
                z-index: 10000;
                display: flex;
                justify-content: center;
                align-items: center;
            `;
            popup.setAttribute('data-agp-popup', sessionId);

            const titleId = `agp-popup-title-${sessionId}`;
            const popupContent = document.createElement('div');
            popupContent.setAttribute('role', 'dialog');
            popupContent.setAttribute('aria-modal', 'true');
            popupContent.setAttribute('aria-labelledby', titleId);
            popupContent.style.cssText = `
                background: white;
                border-radius: 8px;
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
                position: relative;
                width: ${config.popupWidth}px;
                height: ${config.popupHeight}px;
                max-width: 90vw;
                max-height: 90vh;
                display: flex;
                flex-direction: column;
            `;

            // Create header with close button
            const header = document.createElement('div');
            header.style.cssText = `
                padding: 16px 20px;
                border-bottom: 1px solid #e1e1e1;
                display: flex;
                justify-content: space-between;
                align-items: center;
                background: #f8f9fa;
                border-radius: 8px 8px 0 0;
                font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            `;

            const title = document.createElement('h2');
            title.id = titleId;
            title.tabIndex = -1;
            title.textContent = config.popupTitle;
            title.style.cssText = `
                margin: 0;
                font-size: 16px;
                font-weight: 600;
                color: #333;
                outline: none;
            `;

            const closeButton = document.createElement('button');
            closeButton.type = 'button';
            closeButton.setAttribute('aria-label', config.closeLabel);
            closeButton.innerHTML = '<span aria-hidden="true">×</span>';
            closeButton.style.cssText = `
                background: none;
                border: none;
                font-size: 24px;
                cursor: pointer;
                color: #444;
                padding: 0;
                width: 32px;
                height: 32px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 4px;
                transition: background-color 0.2s;
            `;

            closeButton.addEventListener('mouseenter', function() {
                this.style.backgroundColor = '#e1e1e1';
            });
            closeButton.addEventListener('mouseleave', function() {
                this.style.backgroundColor = 'transparent';
            });

            header.appendChild(title);
            header.appendChild(closeButton);

            const iframeDiv = document.createElement('div');
            iframeDiv.style.cssText = `
                padding: 24px;
                flex: 1;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            `;

            // Create iframe
            const iframe = document.createElement('iframe');
            const iframeParam = config.previewLevel || 'true';
            const params = new URLSearchParams({ iframe: iframeParam });
            if (config.recipientId) params.set('recipient', config.recipientId);
            if (config.locale) params.set('locale', config.locale);
            iframe.src = `${config.baseUrl}/${config.resourceType}/${sessionId}/sign?${params}`;
            iframe.style.cssText = `
                flex: 1;
                border: none;
                border-radius: 0 0 8px 8px;
                width: 100%;
            `;
            iframe.setAttribute('data-agp-session', sessionId);
            iframe.setAttribute('allow', 'loopback-network');
            iframe.setAttribute('title', config.title);

            popupContent.appendChild(header);
            iframeDiv.appendChild(iframe);
            popupContent.appendChild(iframeDiv);
            popup.appendChild(popupContent);

            // Set up message listener
            this._setupMessageListener(config, iframe);

            // Close on ESC key, also when it is pressed inside the signing iframe (it posts 'agp-escape')
            const handleKeyDown = (e) => {
                if (e.key === 'Escape') {
                    closePopup();
                }
            };
            const handleEscapeMessage = (event) => {
                if (event.source === iframe.contentWindow && event.data && event.data.type === 'agp-escape') {
                    closePopup();
                }
            };

            // Modal behaviour: keep focus inside the popup and restore it to the opener on close
            const opener = document.activeElement;
            const inertElements = Array.from(document.body.children).filter((element) => !element.inert);

            // Stops listening for this popup without calling onClose
            let closed = false;
            const detachPopup = () => {
                closed = true;
                document.removeEventListener('keydown', handleKeyDown);
                window.removeEventListener('message', handleEscapeMessage);
                this._removeMessageListener(iframe);
                inertElements.forEach((element) => { element.inert = false; });
                if (opener && opener.isConnected && typeof opener.focus === 'function') {
                    opener.focus();
                }
            };
            popup._agpDetach = detachPopup;

            // Close popup handlers; onClose runs once however the popup is closed
            const closePopup = () => {
                if (closed) return;

                detachPopup();
                if (popup.parentNode) {
                    popup.parentNode.removeChild(popup);
                }
                if (config.onClose) {
                    config.onClose();
                }
            };

            closeButton.addEventListener('click', closePopup);

            // Close on overlay click
            popup.addEventListener('click', function(e) {
                if (e.target === popup) {
                    closePopup();
                }
            });

            document.addEventListener('keydown', handleKeyDown);
            window.addEventListener('message', handleEscapeMessage);

            document.body.appendChild(popup);
            inertElements.forEach((element) => { element.inert = true; });
            title.focus();

            return {
                popup: popup,
                iframe: iframe,
                close: closePopup,
                destroy: closePopup
            };
        },

        // Set up message listener
        _setupMessageListener: function (config, iframe) {
            const messageHandler = (event) => {
                // Only messages from this instance's iframe, not from other AGP iframes on the page
                if (event.source !== iframe.contentWindow) return;

                if (config.onMessage && typeof config.onMessage === 'function' && event.data && event.data.type === 'agp-custom-event') {
                    config.onMessage(event.data, event.origin, iframe);
                }
            };

            window.addEventListener('message', messageHandler);

            // Store reference to remove listener if needed
            iframe._agpMessageHandler = messageHandler;
        },

        _removeMessageListener: function (iframe) {
            if (iframe._agpMessageHandler) {
                window.removeEventListener('message', iframe._agpMessageHandler);
                iframe._agpMessageHandler = null;
            }
        },

        // Utility method to destroy all AGP instances
        destroyAll: function() {
            // Remove all iframes
            const iframes = document.querySelectorAll('[data-agp-session]');
            iframes.forEach(iframe => {
                this._removeMessageListener(iframe);
                if (iframe.parentNode) {
                    iframe.parentNode.removeChild(iframe);
                }
            });

            // Remove all popups
            const popups = document.querySelectorAll('[data-agp-popup]');
            popups.forEach(popup => {
                if (popup._agpDetach) {
                    popup._agpDetach();
                }
                if (popup.parentNode) {
                    popup.parentNode.removeChild(popup);
                }
            });
        }
    };
})();