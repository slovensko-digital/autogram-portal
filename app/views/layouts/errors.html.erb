<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) %> – Autogram Portal</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app %>
    <%= stylesheet_link_tag "tailwind" %>
  </head>

  <body class="min-h-screen bg-gray-50 text-gray-900">
    <header class="bg-white border-b border-gray-200">
      <div class="mx-auto flex h-16 max-w-3xl items-center px-4 sm:px-6">
        <a href="<%= root_path %>" class="flex items-center rounded-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2">
          <span class="font-logo text-2xl font-bold text-gray-900" style="background: linear-gradient(to bottom, transparent 90%, #FDE047 10%);">Autogram <span class="font-normal">Portal</span></span>
        </a>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
      <%= yield %>
    </main>
  </body>
</html>
