<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for?(:title) ? "#{content_for(:title)} – Autogram Portal" : "Autogram Portal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= t('layouts.meta.description') %>">
    <meta property="og:title" content="Autogram Portal">
    <meta property="og:description" content="<%= t('layouts.meta.og_description') %>">
    <meta property="og:image" content="<%= "#{request.base_url}/og-image.png" %>">
    <meta property="og:url" content="<%= "#{request.base_url}#{request.path}" %>">
    <meta property="og:type" content="website">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# I18n for JavaScript %>
    <% javascript_translations = I18n.t('javascript', default: {}).deep_merge(
      bundles: {
        autogram_batch: I18n.t('bundles.autogram_batch', default: {}),
        sign: {
          batch_sign_unavailable: I18n.t('bundles.sign.batch_sign_unavailable')
        }
      }
    ) %>
    <meta name="i18n-locale" content="<%= I18n.locale %>">
    <meta name="i18n-translations" content="<%= {
      I18n.locale => javascript_translations
    }.to_json %>">

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% no_padding_top = @no_header || flash_messages.any? || current_page?(about_index_path) || current_page?(docs_path) || current_page?(how_to_sign_index_path) %>
  <body class="<%= 'lg:pt-24' unless no_padding_top %> <%= 'bg-gradient-to-tr from-slate-50 to-gray-50 text-gray-900 antialiased' unless params[:iframe] %>">
    <a href="#main-content" data-turbo="false" class="sr-only focus:not-sr-only focus:absolute focus:top-0 focus:left-0 focus:z-[1000] focus:bg-yellow-300 focus:px-4 focus:py-2 focus:text-gray-950 focus:outline-3 focus:outline-yellow-300"><%= t('layouts.skip_to_main_content') %></a>
    <%= render "layouts/header" unless @no_header %>

    <main id="main-content" tabindex="-1" class="<%= 'min-h-screen' unless @no_footer %> <%= 'lg:pl-64' unless @no_header %> focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-600">
      <%= render("layouts/flash", flash: flash) unless @no_flash %>

      <%= yield %>
    </main>

    <%= render "layouts/footer" unless @no_footer %>
  </body>
</html>
