<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title><%= message.subject %></title>
    <style>
      body, table, td, p, a, span, h1, h2 {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
      }
      body { margin: 0; padding: 0; background-color: #F3F4F6; -webkit-text-size-adjust: 100%; }
      table { border-collapse: collapse; }
      a { color: #155DFC; }
      @media only screen and (max-width: 600px) {
        .email-outer { padding: 16px 8px !important; }
        .email-card { padding: 28px 20px !important; }
        .email-title { font-size: 22px !important; }
        .email-code { font-size: 32px !important; letter-spacing: 0.2em !important; }
        .email-details-label { display: block !important; width: auto !important; padding-bottom: 0 !important; }
        .email-details-value { display: block !important; padding: 2px 20px 8px !important; }
      }
    </style>
  </head>

  <body style="margin: 0; padding: 0; background-color: #F3F4F6;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#F3F4F6" style="background-color: #F3F4F6;">
      <tr>
        <td align="center" class="email-outer" style="padding: 32px 16px;">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width: 600px; width: 100%;">
            <tr>
              <td style="padding: 0 8px 20px; font-family: 'Source Sans 3', 'Source Sans Pro', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 22px; line-height: 1.3; color: #111827;">
                <span style="border-bottom: 3px solid #FDE047; padding: 0 2px;"><strong>Autogram</strong> Portal</span>
              </td>
            </tr>
            <tr>
              <td class="email-card" bgcolor="#FFFFFF" style="background-color: #FFFFFF; border-radius: 12px; padding: 40px; color: #111827;">
                <%= yield %>

                <p style="margin: 0; font-size: 16px; line-height: 1.6; color: #374151;">
                  <%= t('.regards') %><br>
                  <%= t('.team') %>
                </p>
              </td>
            </tr>
            <tr>
              <td style="padding: 20px 8px 0; font-size: 13px; line-height: 1.5; color: #4B5563;">
                <%= t('.operator') %>
                <%= Rails.application.config.footer[:provider_name] %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
