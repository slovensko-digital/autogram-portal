<%# locals: (beside_sidebar: false, spaced: false) %>
<aside id="staging-notice" aria-label="<%= t('layouts.staging_notice.label') %>" class="bg-yellow-300 text-gray-950 <%= 'lg:pl-64' if beside_sidebar %> <%= 'lg:mb-16' if spaced %>">
  <div aria-hidden="true" class="h-2 bg-[repeating-linear-gradient(-45deg,#030712_0_10px,#fde047_10px_20px)]"></div>
  <div class="mx-auto flex max-w-5xl items-start gap-3 px-4 py-3 text-sm sm:px-6">
    <svg aria-hidden="true" class="mt-0.5 h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
    </svg>
    <p>
      <%= t('layouts.staging_notice.text_html',
            link: link_to(StagingInstance.production_host, StagingInstance.production_url, class: "font-semibold underline underline-offset-2 hover:no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-950 rounded-sm")) %>
    </p>
  </div>
</aside>
