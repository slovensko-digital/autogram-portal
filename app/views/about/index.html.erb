      <div class="bg-white/5 rounded-2xl p-8 ring-1 ring-white/10">
        <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-green-500/10">
          <svg class="h-10 w-10 text-green-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
          </svg>
        </div>
        <h3 class="mt-6 text-xl font-semibold text-white"><%= t('.standards.open_source.title') %></h3>
        <p class="mt-4 text-base text-gray-400">
          <%= t('.standards.open_source.description') %>
        </p>
      </div>
      <div class="bg-white/5 rounded-2xl p-8 ring-1 ring-white/10">
        <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-purple-500/10">
          <svg class="h-10 w-10 text-purple-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z" />
          </svg>
        </div>
        <h3 class="mt-6 text-xl font-semibold text-white"><%= t('.standards.api.title') %></h3>
        <p class="mt-4 text-base text-gray-400">
          <%= t('.standards.api.description') %>
        </p>
      </div>
    </div>
    <div class="mx-auto mt-16 max-w-2xl text-center">
      <h3 class="text-2xl font-bold text-white"><%= t('.cta.title') %></h3>
      <p class="mt-4 text-lg text-gray-400">
        <%= t('.cta.subtitle') %>
      </p>
      <div class="mt-8 flex items-center justify-center gap-x-6">
        <%= link_to t('.cta.start_signing'), new_contract_path,
            class: "rounded-md bg-blue-600 px-4 py-3 text-base font-semibold text-white  hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" %>
        <a href="https://github.com/slovensko-digital/autogram-portal" class="text-base font-semibold leading-6 text-white hover:text-gray-300">
          <%= t('.cta.view_github') %> <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</div>
<div class="bg-white py-24 sm:py-32">
  <div class="mx-auto max-w-4xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-base font-semibold leading-7 text-blue-600"><%= t('.faq.subtitle') %></h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        <%= t('.faq.title') %>
      </p>
    </div>
    <dl class="mt-16 space-y-4">
      <% t('.faq.items').each do |_key, item| %>
        <details class="group rounded-xl border border-gray-200">
          <summary class="flex cursor-pointer items-center justify-between gap-x-4 px-6 py-5 text-base font-semibold text-gray-900 hover:bg-gray-100 rounded-xl [list-style:none] [&::-webkit-details-marker]:hidden">
            <%= item[:question] %>
            <svg class="h-5 w-5 flex-shrink-0 text-gray-500 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </summary>
          <div class="px-6 pb-5 pt-2 text-base text-gray-600 leading-7">
            <%= item[:answer] %>
          </div>
        </details>
      <% end %>
    </dl>
  </div>
</div>
