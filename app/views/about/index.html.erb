        <a href="https://github.com/slovensko-digital/autogram-portal" class="inline-flex min-h-12 items-center gap-2 text-base font-semibold text-white hover:text-gray-300">
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <%= t('.cta.view_github') %> <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<%# FAQ %>
<section class="bg-white px-6 py-24 lg:px-8">
  <div class="mx-auto grid max-w-6xl grid-cols-1 items-start gap-10 lg:grid-cols-3 lg:gap-16">
    <div>
      <p class="text-base font-semibold leading-7 text-blue-600"><%= t('.faq.subtitle') %></p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"><%= t('.faq.title') %></h2>
      <p class="mt-4 text-base leading-7 text-gray-600">
        <%= t('.faq.help_html',
              email: mail_to(support_email, support_email, class: "font-semibold text-blue-600 underline hover:text-blue-800"),
              docs: link_to(t('.faq.docs_link'), docs_path, class: "font-semibold text-blue-600 underline hover:text-blue-800")) %>
      </p>
    </div>
    <div class="border-t border-gray-200 lg:col-span-2">
      <% t('.faq.items').each_with_index do |(key, item), index| %>
        <details class="group border-b border-gray-200" <%= 'open' if index.zero? %>>
          <summary class="flex cursor-pointer items-center justify-between gap-x-4 py-5 text-lg font-semibold text-gray-900 hover:bg-gray-50 [list-style:none] [&::-webkit-details-marker]:hidden">
            <%= item[:question] %>
            <span aria-hidden="true" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gray-100 text-blue-600 transition-transform group-open:rotate-45">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
            </span>
          </summary>
          <div class="pb-5 pr-12 text-base leading-7 text-gray-600">
            <%= faq_answer(key, item) %>
          </div>
        </details>
      <% end %>
    </div>
  </div>
</section>
